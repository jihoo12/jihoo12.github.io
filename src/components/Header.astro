---
const current = Astro.url.pathname;
---
<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
  <div class="wrap nav-wrap">
    <a class="brand" href="/" aria-label="Jihoo — home"><span class="brand-monogram" aria-hidden="true">J.</span><span class="brand-text">Jihoo<small>INDEPENDENT NOTEBOOK</small></span></a>
    <nav aria-label="Primary navigation">
      <a class:list={{ active: current === '/' }} aria-current={current === '/' ? 'page' : undefined} href="/">Index</a>
      <a class:list={{ active: current.startsWith('/blog') }} aria-current={current.startsWith('/blog') ? 'page' : undefined} href="/blog/">Notebook</a>
      <a class:list={{ active: current.startsWith('/about') }} aria-current={current.startsWith('/about') ? 'page' : undefined} href="/about/">Profile</a>
    </nav>
    <a class="header-external" href="https://github.com/jihoo12" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
  </div>
</header>
<style>
  .site-header { border-top: 4px solid var(--ink); border-bottom: 1px solid var(--rule); background: var(--paper); }
  .nav-wrap { display: flex; min-height: 90px; justify-content: space-between; align-items: center; gap: 30px; }
  .brand { display: flex; align-items: center; gap: 13px; flex: 0 0 auto; }
  .brand-monogram { display: grid; place-items: center; width: 42px; height: 42px; border: 1px solid var(--ink); font: 500 25px var(--serif); }
  .brand-text { font: 600 22px/1 var(--serif); letter-spacing: -.02em; }
  .brand-text small { display: block; margin-top: 7px; font: 500 8px/1.2 var(--mono); letter-spacing: .085em; color: var(--quiet); }
  nav { display: flex; align-items: center; gap: 37px; }
  nav a, .header-external { font: 600 12px var(--sans); color: var(--quiet); }
  nav a { padding: 35px 0 32px; border-bottom: 2px solid transparent; }
  nav a:hover, nav a.active, .header-external:hover { color: var(--ink); }
  nav a.active { border-bottom-color: var(--accent); }
  .header-external { white-space: nowrap; border-bottom: 1px solid var(--rule); padding-bottom: 7px; }
  .header-external span { color: var(--accent); }
  @media (max-width: 720px) { .nav-wrap { min-height: 78px; gap: 16px; } .brand-text small { display: none; } nav { gap: 18px; } nav a { padding: 29px 0 25px; } .header-external { display: none; } }
  @media (max-width: 420px) { .brand-monogram { width: 35px; height: 35px; font-size: 21px; } .brand-text { font-size: 19px; } nav { gap: 13px; } nav a { font-size: 11px; } }
</style>

---
import { Image } from 'astro:assets';
import face from '../assets/nixchan/nixchan-avatar.png';
import { type Lang, localize, nav, unlocalize, urlLang } from '../i18n';

interface Props {
	/** Where the language sign leads. Defaults to this page in the other language. */
	alternate?: string;
}
const lang = urlLang(Astro.url);
const other: Lang = lang === 'ko' ? 'en' : 'ko';
const t = nav[lang];
const current = unlocalize(Astro.url.pathname);
const alternate = Astro.props.alternate ?? localize(current, other);
const links = [
	{ label: t.home, href: '/', active: current === '/', drop: 26 },
	{ label: t.projects, href: '/projects/', active: current.startsWith('/projects'), drop: 44 },
	{ label: t.journal, href: '/blog/', active: current.startsWith('/blog') || current.startsWith('/papers'), drop: 18 },
	{ label: t.comics, href: '/comics/', active: current.startsWith('/comics'), drop: 30 },
	{ label: t.about, href: '/about/', active: current.startsWith('/about'), drop: 36 },
].map((link) => ({ ...link, href: localize(link.href, lang) }));
---
<header class="signs wrap">
	<a class="sign brand" style="--drop:30px" href={localize('/', lang)} aria-label={t.homeLabel}><Image class="brand-mark" src={face} alt="" width={64} height={64} loading="eager" /><span class="brand-word">jihoo<span class="period">.</span></span></a>
	<nav aria-label={t.main}>
		{links.map((link) => (
			<a class:list={['sign', { active: link.active, 'home-link': link.href === localize('/', lang) }]} style={`--drop:${link.drop}px`} href={link.href} aria-current={link.active ? 'page' : undefined}>{link.label}</a>
		))}
	</nav>
	<div class="right">
		<a class="sign github" style="--drop:22px" href="https://github.com/jihoo12" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
		<a class="sign lang" style="--drop:30px" href={alternate} hreflang={other} lang={other} aria-label={t.switchLabel} data-lang={other}>{t.switchTo}</a>
		<button class="sign clock" style="--drop:40px" type="button" data-clock aria-label={t.clock}><span class="sun" aria-hidden="true">☀</span><span class="moon" aria-hidden="true">☾</span></button>
	</div>
</header>
<script>
	const button = document.querySelector<HTMLButtonElement>('[data-clock]');
	button?.addEventListener('click', () => {
		const next = document.documentElement.dataset.time === 'night' ? 'day' : 'night';
		document.documentElement.dataset.time = next;
		try {
			localStorage.setItem('time', next);
		} catch {
			// The choice just won't be remembered.
		}
		window.dispatchEvent(new Event('site-time'));
	});
</script>
<style>
	.signs { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; position: relative; z-index: 10; }
	nav, .right { display: flex; align-items: flex-start; gap: 12px; }
	.sign {
		position: relative; display: inline-flex; align-items: center; gap: 8px;
		--hang: var(--drop);
		margin-top: var(--hang); padding: 8px 15px; border: 0; border-radius: 9px;
		background: var(--surface); color: var(--ink); font-family: var(--sans); font-size: 15px; font-weight: 800;
		box-shadow: 0 4px 0 var(--edge); cursor: pointer;
		transform-origin: 50% calc(var(--hang) * -1);
	}
	.sign::before, .sign::after {
		content: ''; position: absolute; bottom: 100%; width: 2px; height: var(--hang); background: var(--string);
	}
	.sign::before { left: 22%; }
	.sign::after { right: 22%; }
	.sign:hover { animation: swing .9s ease-in-out; }
	.sign.active { background: var(--star); color: #1c1a3e; box-shadow: 0 4px 0 #b98c22; }
	.brand { padding: 7px 14px 7px 7px; }
	.brand-word { font-family: var(--display); font-size: 21px; font-weight: 400; line-height: 1; }
	.brand-mark { width: 34px; height: 34px; border-radius: 50%; object-fit: cover; }
	.lang { height: 40px; padding: 0 13px; font-size: 14px; color: var(--accent); }
	.clock { width: 42px; height: 40px; justify-content: center; padding: 0; font-size: 20px; color: var(--accent); }
	.moon { display: none; }
	:global(:root[data-time='night']) .sun { display: none; }
	:global(:root[data-time='night']) .moon { display: inline; }
	@keyframes swing {
		0%, 100% { transform: rotate(0); }
		25% { transform: rotate(2.6deg); }
		60% { transform: rotate(-1.8deg); }
		85% { transform: rotate(.7deg); }
	}
	@media (max-width: 900px) {
		.github { display: none; }
		.home-link { display: none; }
		nav, .right { gap: 8px; }
		.signs { gap: 8px; }
		.sign { padding: 8px 12px; font-size: 15px; }
		.brand { padding: 5px; }
		.brand-word { display: none; }
		.brand-mark { width: 32px; height: 32px; }
		.lang { height: 38px; padding: 0 11px; }
		.clock { width: 40px; height: 38px; padding: 0; font-size: 19px; }
	}
	/* Too many signs for one string line on a phone: the tabs get their own row, hung from a plank. */
	@media (max-width: 560px) {
		.signs { flex-wrap: wrap; row-gap: 0; }
		nav { order: 3; position: relative; flex: 0 0 100%; gap: 6px; margin-top: 18px; }
		nav::before {
			content: ''; position: absolute; z-index: 1; top: 0; left: -6px; right: -6px; height: 8px;
			border-radius: 4px; background: var(--plank); box-shadow: 0 8px 14px -8px var(--shadow);
		}
		nav .sign { --hang: calc(var(--drop) / 2 + 8px); flex: 1 1 0; justify-content: center; min-width: 0; padding: 8px 4px; font-size: 14px; }
	}
	@media (prefers-reduced-motion: reduce) { .sign:hover { animation: none; } }
</style>

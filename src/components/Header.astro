---
import { Image } from 'astro:assets';
import face from '../assets/nixchan/nixchan-avatar.png';
const current = Astro.url.pathname;
const links = [
	{ label: 'Home', href: '/', active: current === '/', drop: 26 },
	{ label: 'Projects', href: '/projects/', active: current.startsWith('/projects'), drop: 44 },
	{ label: 'Journal', href: '/blog/', active: current.startsWith('/blog') || current.startsWith('/ko/blog'), drop: 18 },
	{ label: 'About', href: '/about/', active: current.startsWith('/about'), drop: 36 },
];
---
<header class="signs wrap">
	<a class="sign brand" style="--drop:30px" href="/" aria-label="Jihoo home"><Image class="brand-mark" src={face} alt="" width={64} height={64} loading="eager" /><span class="brand-word">jihoo<span class="period">.</span></span></a>
	<nav aria-label="Main navigation">
		{links.map((link) => (
			<a class:list={['sign', { active: link.active, 'home-link': link.href === '/' }]} style={`--drop:${link.drop}px`} href={link.href} aria-current={link.active ? 'page' : undefined}>{link.label}</a>
		))}
	</nav>
	<div class="right">
		<a class="sign github" style="--drop:22px" href="https://github.com/jihoo12" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
		<button class="sign clock" style="--drop:40px" type="button" data-clock aria-label="Switch between day and night"><span class="sun" aria-hidden="true">☀</span><span class="moon" aria-hidden="true">☾</span></button>
	</div>
</header>
<script>
	const button = document.querySelector<HTMLButtonElement>('[data-clock]');
	button?.addEventListener('click', () => {
		const next = document.documentElement.dataset.time === 'night' ? 'day' : 'night';
		document.documentElement.dataset.time = next;
		try {
			localStorage.setItem('time', next);
		} catch {
			// The choice just won't be remembered.
		}
		window.dispatchEvent(new Event('site-time'));
	});
</script>
<style>
	.signs { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; position: relative; z-index: 10; }
	nav, .right { display: flex; align-items: flex-start; gap: 12px; }
	.sign {
		position: relative; display: inline-flex; align-items: center; gap: 8px;
		margin-top: var(--drop); padding: 8px 15px; border: 0; border-radius: 9px;
		background: var(--surface); color: var(--ink); font-family: var(--sans); font-size: 15px; font-weight: 800;
		box-shadow: 0 4px 0 var(--edge); cursor: pointer;
		transform-origin: 50% calc(var(--drop) * -1);
	}
	.sign::before, .sign::after {
		content: ''; position: absolute; bottom: 100%; width: 2px; height: var(--drop); background: var(--string);
	}
	.sign::before { left: 22%; }
	.sign::after { right: 22%; }
	.sign:hover { animation: swing .9s ease-in-out; }
	.sign.active { background: var(--star); color: #1c1a3e; box-shadow: 0 4px 0 #b98c22; }
	.brand { padding: 7px 14px 7px 7px; }
	.brand-word { font-family: var(--display); font-size: 21px; font-weight: 400; line-height: 1; }
	.brand-mark { width: 34px; height: 34px; border-radius: 50%; object-fit: cover; }
	.clock { width: 42px; height: 40px; justify-content: center; padding: 0; font-size: 20px; color: var(--accent); }
	.moon { display: none; }
	:global(:root[data-time='night']) .sun { display: none; }
	:global(:root[data-time='night']) .moon { display: inline; }
	@keyframes swing {
		0%, 100% { transform: rotate(0); }
		25% { transform: rotate(2.6deg); }
		60% { transform: rotate(-1.8deg); }
		85% { transform: rotate(.7deg); }
	}
	@media (max-width: 760px) {
		.github { display: none; }
		.home-link { display: none; }
		nav, .right { gap: 8px; }
		.signs { gap: 8px; }
		.sign { padding: 8px 12px; font-size: 15px; }
		.brand { padding: 5px; }
		.brand-word { display: none; }
		.brand-mark { width: 32px; height: 32px; }
		.clock { width: 40px; height: 38px; padding: 0; font-size: 19px; }
	}
	@media (prefers-reduced-motion: reduce) { .sign:hover { animation: none; } }
</style>

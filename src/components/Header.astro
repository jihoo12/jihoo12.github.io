---
import { Image } from 'astro:assets';
import face from '../assets/nixchan/nixchan-avatar.png';
const current = Astro.url.pathname;
---
<header class="site-header"><div class="wrap nav-wrap"><a class="brand" href="/" aria-label="Jihoo home"><Image class="brand-mark" src={face} alt="" width={64} height={64} loading="eager" /> jihoo<span class="brand-dot">.</span></a><nav aria-label="Main navigation"><a class:list={{active:current==='/'}} href="/">Home</a><a class:list={{active:current.startsWith('/projects')}} href="/projects/">Projects</a><a class:list={{active:current.startsWith('/blog')}} href="/blog/">Journal</a><a class:list={{active:current.startsWith('/about')}} href="/about/">About</a></nav><a class="github-link" href="https://github.com/jihoo12" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a></div></header>
<style>.site-header{position:sticky;top:0;z-index:10;background:color-mix(in srgb,var(--bg) 86%,transparent);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}.nav-wrap{height:80px;display:flex;align-items:center;justify-content:space-between}.brand{display:flex;align-items:center;gap:10px;font-family:'DM Sans',sans-serif;font-size:23px;font-weight:700;letter-spacing:-1.2px}.brand-mark{width:34px;height:34px;border-radius:50%;object-fit:cover;box-shadow:0 0 0 2px var(--surface),0 0 0 3px var(--line)}.brand-dot{color:var(--star);margin-left:-9px}.site-header nav{display:flex;gap:42px;margin-left:38px}.site-header nav a{font-family:'DM Sans',sans-serif;color:var(--faint);font-size:12px;font-weight:700;transition:color .2s}.site-header nav a:hover,.site-header nav a.active{color:var(--navy)}.site-header nav a.active{box-shadow:inset 0 -2px 0 var(--sky);padding-bottom:4px}.github-link{font-family:'DM Sans',sans-serif;font-size:12px;font-weight:700;border:1px solid var(--line);background:var(--surface);padding:11px 16px;border-radius:8px}.github-link span{margin-left:10px;color:var(--accent)}@media(max-width:600px){.nav-wrap{height:68px}.brand{font-size:20px}.brand-mark{width:28px;height:28px}.site-header nav{gap:14px;margin-left:0}.site-header nav a{font-size:11px}.github-link{display:none}}</style>

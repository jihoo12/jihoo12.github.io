---
const current = Astro.url.pathname;
---
<header class="site-header"><div class="wrap nav-wrap"><a class="brand" href="/" aria-label="Jihoo 홈"><span class="brand-mark">j<span>✳</span></span> jihoo<span class="brand-dot">.</span></a><nav aria-label="주 메뉴"><a class:list={{active:current==='/'}} href="/">Home</a><a class:list={{active:current.startsWith('/blog')}} href="/blog/">Journal</a><a class:list={{active:current.startsWith('/about')}} href="/about/">About</a></nav><a class="github-link" href="https://github.com/jihoo12" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a></div></header>
<style>.site-header{background:#fbfaf6;border-bottom:1px solid #eeeeea}.nav-wrap{height:86px;display:flex;align-items:center;justify-content:space-between}.brand{display:flex;align-items:center;gap:9px;font-family:'DM Sans',sans-serif;font-size:23px;font-weight:700;letter-spacing:-1.2px}.brand-mark{display:inline-flex;align-items:center;justify-content:center;background:#e6efdb;color:#65845c;border-radius:50%;font-size:16px;width:30px;height:30px}.brand-mark span{font-size:8px;transform:translate(-1px,-7px)}.brand-dot{color:#deb969;margin-left:-9px}.site-header nav{display:flex;gap:42px;margin-left:38px}.site-header nav a{font-family:'DM Sans',sans-serif;color:#9a9d94;font-size:12px;font-weight:700;transition:color .2s}.site-header nav a:hover,.site-header nav a.active{color:#304d33}.github-link{font-family:'DM Sans',sans-serif;font-size:12px;font-weight:700;border:1px solid #e2e5da;padding:11px 16px;border-radius:6px}.github-link span{margin-left:10px;color:#759273}@media(max-width:600px){.nav-wrap{height:72px}.brand{font-size:20px}.site-header nav{gap:17px;margin-left:0}.site-header nav a{font-size:11px}.github-link{display:none}}</style>
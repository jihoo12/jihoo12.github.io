---
import { REGISTRIES } from '../consts';
import { ACTIVITY_DAYS } from '../lib/activity';
import type { ProjectData } from '../lib/projects';

interface Props {
	project: ProjectData;
	// Commits in the activity window, shown when there were any.
	commits?: number;
	// Show the full GitHub description and links (projects page) or only the first sentence (homepage).
	detailed?: boolean;
}

const { project, commits = 0, detailed = false } = Astro.props;
const { title, tagline, description, language, tags, repo, homepage, stars, package: pkg } = project;
const registry = pkg && REGISTRIES[pkg.registry];
const languageColors: Record<string, string> = {
	Rust: '#d39a6a',
	C: '#8a9bb0',
	'C++': '#c27a9a',
	JavaScript: '#e0c264',
	TypeScript: '#6f93c4',
	Python: '#6f9a8e',
};
---
<article class:list={['project-card', { detailed }]}>
	<div class="card-top">
		<span class="language"><span class="lang-dot" style={`background:${languageColors[language] ?? 'var(--faint)'}`}></span>{language}</span>
		<span class="card-badges">
			{detailed && stars > 0 && <span class="activity" title={`${stars} stars on GitHub`}>★ {stars}</span>}
			{commits > 0 && <span class="activity" title={`${commits} commits in the last ${ACTIVITY_DAYS} days`}>{commits} commits · {ACTIVITY_DAYS}d</span>}
			{registry && <span class="registry">{registry.label}</span>}
		</span>
	</div>
	<h3><a href={repo} target="_blank" rel="noopener noreferrer">{title} <span aria-hidden="true">↗</span></a></h3>
	<p class="tagline">{detailed ? description : tagline}</p>
	{detailed && pkg && registry && (
		<a class="install" href={registry.url(pkg.name)} target="_blank" rel="noopener noreferrer"><code>{registry.install(pkg.name)}</code><span aria-hidden="true">↗</span></a>
	)}
	<div class="card-bottom">
		<ul class="tags">{tags.map((tag) => <li>{tag}</li>)}</ul>
		{detailed && (
			<div class="links">
				<a href={repo} target="_blank" rel="noopener noreferrer">Source</a>
				{homepage && <a href={homepage} target="_blank" rel="noopener noreferrer">Website</a>}
			</div>
		)}
	</div>
</article>
<style>
	.project-card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 26px;
		background: var(--surface);
		border-radius: 16px;
		box-shadow: 0 7px 0 var(--edge);
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}
	.project-card:hover {
		transform: translateY(-3px);
		box-shadow: 0 10px 0 var(--edge);
	}
	.card-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
				font-size: 13px;
		font-weight: 800;
		color: var(--accent);
	}
	.language {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}
	.lang-dot {
		width: 9px;
		height: 9px;
		border-radius: 50%;
	}
	.card-badges {
		display: inline-flex;
		align-items: center;
		gap: 10px;
	}
	.activity {
		font-weight: 600;
		color: var(--faint);
	}
	.registry {
		background: #fdf3d6;
		color: #9a7313;
		padding: 4px 9px;
		border-radius: 20px;
		letter-spacing: 0.5px;
	}
	h3 {
		margin: 0;
		font-size: 25px;
		font-weight: 900;
		line-height: 1.2;
	}
	/* The whole card is clickable on the summary version; detailed cards keep their own links. */
	.project-card:not(.detailed) h3 a::after {
		content: '';
		position: absolute;
		inset: 0;
	}
	h3 span {
		color: var(--accent);
		font-size: 17px;
		margin-left: 4px;
	}
	.tagline {
		margin: 0;
		color: var(--muted);
		font-size: 15.5px;
		line-height: 1.6;
	}
	.install {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		background: var(--accent-soft);
		border-radius: 7px;
		padding: 11px 14px;
		color: var(--navy);
		font-size: 12.5px;
		transition: background 0.2s;
	}
	.install:hover {
		background: color-mix(in srgb, var(--accent-soft) 80%, var(--accent));
	}
	.install code {
		overflow-wrap: anywhere;
	}
	.card-bottom {
		margin-top: auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 12px;
		padding-top: 6px;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.tags li {
				font-size: 12.5px;
		font-weight: 800;
		color: var(--accent);
		background: var(--accent-soft);
		border-radius: 20px;
		padding: 3px 9px;
	}
	.links {
		display: flex;
		gap: 16px;
		font-size: 14px;
		font-weight: 800;
		color: var(--navy);
	}
	.links a {
		border-bottom: 1px solid var(--sky);
		padding-bottom: 2px;
	}
	.links a:hover {
		border-color: var(--navy);
	}
	@media (max-width: 480px) {
		.project-card {
			padding: 22px 20px;
		}
		h3 {
			font-size: 20px;
		}
	}
</style>

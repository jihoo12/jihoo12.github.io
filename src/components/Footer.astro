---
import { Image } from 'astro:assets';
import nap from '../assets/nixchan/nixchan-penguin-nap-01.png';
import { localize, nav, urlLang } from '../i18n';

const lang = urlLang(Astro.url);
const t = nav[lang];
const ko = lang === 'ko';
---
<footer class="site-footer">
	<div class="wrap footer-inner">
		<div class="footer-left">
			<Image class="footer-art" src={nap} alt={ko ? '펭귄과 함께 낮잠 자는 닉스쨩' : 'Nixchan napping with a penguin'} width={200} height={200} />
			{ko ? <p>조금씩,<br />나만의 속도로<span>.</span></p> : <p>A little at a time,<br />at my own pace<span>.</span></p>}
		</div>
		<div class="footer-right">
			<nav aria-label={ko ? '바닥글' : 'Footer'}>
				<a href={localize('/projects/', lang)}>{t.projects}</a>
				<a href={localize('/blog/', lang)}>{t.journal}</a>
				<a href={localize('/comics/', lang)}>{t.comics}</a>
				<a href={localize('/about/', lang)}>{t.about}</a>
				<a href="https://github.com/jihoo12" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
			</nav>
			<small>© {new Date().getFullYear()} Jihoo. {ko ? '그림: 닉스쨩.' : 'Illustrations: Nixchan.'}</small>
		</div>
	</div>
</footer>
<style>
	.site-footer { background: var(--floor); color: #eeedff; padding: 56px 0 44px; }
	.footer-inner { display: flex; justify-content: space-between; align-items: end; gap: 32px; }
	.footer-left { display: flex; align-items: center; gap: 24px; }
	.footer-art { width: 100px; height: 100px; object-fit: cover; border: 5px solid #fff; border-radius: 3px; transform: rotate(-3deg); }
	p { margin: 0; font-family: var(--display); font-size: clamp(25px, 3.4vw, 40px); line-height: 1.15; }
	p span { color: var(--star); }
	.footer-right { display: grid; justify-items: end; gap: 12px; }
	nav { display: flex; flex-wrap: wrap; gap: 8px 22px; font-size: 15px; font-weight: 800; }
	nav a:hover { color: var(--star); }
	small { color: #b3b1dc; font-size: 13px; }
	@media (max-width: 760px) {
		.footer-inner { flex-direction: column; align-items: start; }
		.footer-right { justify-items: start; }
	}
</style>

---
import { Image } from 'astro:assets';
import nap from '../assets/nixchan/nixchan-penguin-nap-01.png';
---
<footer class="site-footer"><div class="wrap footer-inner"><div class="footer-left"><Image class="footer-art" src={nap} alt="Nixchan napping with a penguin" width={160} height={160} /><div><a class="footer-brand" href="/">jihoo<span>.</span></a><p>A little at a time, at my own pace.</p></div></div><div class="footer-right"><a href="/projects/">Projects ↗</a><a href="https://github.com/jihoo12" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="/about/">About ↗</a><span>© {new Date().getFullYear()} Jihoo. Illustrations: Nixchan.</span></div></div></footer><style>.site-footer{background:var(--navy);color:#e9e8ff;padding:52px 0}.footer-inner{display:flex;justify-content:space-between;align-items:center;gap:32px}.footer-left{display:flex;align-items:center;gap:22px}.footer-art{width:80px;height:80px;border-radius:16px;object-fit:cover}.footer-brand{font-family:'DM Sans',sans-serif;font-size:23px;font-weight:800}.footer-brand span{color:var(--star)}.footer-inner p{font-size:12px;color:#a9a7d6;margin:10px 0 0}.footer-right{display:flex;align-items:center;gap:25px;flex-wrap:wrap;font-family:'DM Sans','Noto Sans KR',sans-serif;font-size:11px;font-weight:700;color:#c9c7f5}.footer-right a:hover{color:#fff}.footer-right span{color:#8f8dc0;font-weight:500}@media(max-width:700px){.footer-inner{flex-direction:column;align-items:start}.footer-right{gap:18px}}</style>

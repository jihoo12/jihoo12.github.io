---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import sleepyArt from '../assets/nixchan/nixchan-sleepy-desk-01.png';
---
<!doctype html><html lang="en"><head><BaseHead title="Not found — Jihoo" description="This page doesn't exist." /></head><body><Header/><main class="wrap lost"><div class="art"><div class="glow"></div><Image src={sleepyArt} alt="Nixchan asleep on her desk next to a to-do list" width={480} loading="eager" /></div><span class="eyebrow">404 / NOT FOUND</span><h1>Nothing here<span class="period">.</span></h1><p>This page doesn't exist, or it fell asleep before it was finished.</p><a class="button primary" href="/">Back to home →</a></main><Footer/></body></html><style>.lost{min-height:72vh;padding:80px 0 120px;display:flex;flex-direction:column;align-items:center;text-align:center}.lost .art{width:min(260px,70vw);margin-bottom:44px}.lost h1{font-size:clamp(40px,6vw,62px);letter-spacing:-2.5px;margin:18px 0 12px}.lost p{color:var(--muted);font-size:15px;margin:0 0 32px}</style>

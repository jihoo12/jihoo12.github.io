---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NixChan from '../components/NixChan.astro';
---
<!doctype html><html lang="en"><head><BaseHead title="Not found — Jihoo" description="This page doesn't exist." /></head><body><Header/><main class="wrap lost"><div class="lost-stage"><div class="lost-card"><span class="eyebrow">404 / NOT FOUND</span><h1>Nothing here<span class="period">.</span></h1><p>This page doesn't exist. Nixchan is looking for it, but no luck so far.</p><a class="button primary" href="/">Back to home →</a></div><NixChan perch=".lost-card" pose="search" /></div></main><Footer/></body></html><style>.lost{min-height:72vh;padding:calc(var(--nix-above) + 40px) 0 120px;display:flex;flex-direction:column;align-items:center;text-align:center}.lost-stage{position:relative;width:min(560px,100%)}.lost-card{padding:calc(var(--nix-w) * .25 + 34px) 28px 48px;background:var(--surface);border-radius:16px;box-shadow:0 7px 0 var(--edge)}.lost h1{font-size:clamp(40px,6vw,62px);letter-spacing:-2.5px;margin:18px 0 12px}.lost p{color:var(--muted);font-size:17px;font-weight:600;margin:0 0 32px}</style>

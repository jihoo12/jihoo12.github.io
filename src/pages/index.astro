---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const recentPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const topProjects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---
<!doctype html>
<html lang="en">
  <head><BaseHead title="Jihoo — Small notes, new beginnings" description="A little corner of the internet for things I make, learn, and love." /></head>
  <body>
    <Header />
    <main>
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <span class="eyebrow"><span class="dot"></span> HELLO, I'M JIHOO</span>
          <h1 id="hero-title">Hey there,<br/>I'm <em>Jihoo</em><span class="period">.</span></h1>
          <p class="lead">I build what sparks my curiosity and write down what I learn.<br/>Finding joy in the little things along the way.</p>
          <div class="hero-actions"><a class="button primary" href="/about/">More about me <span aria-hidden="true">↗</span></a><a class="button secondary" href="/blog/">Explore the journal <span aria-hidden="true">→</span></a></div>
          <div class="hero-footnote"><span class="little-star">✳</span> A LITTLE SPACE ON THE INTERNET</div>
        </div>
        <div class="hero-art"><div class="image-glow"></div><img src="/images/jihoo-hero.webp" alt="A smiling white character walking through a sunny wildflower meadow" width="1293" height="1217" fetchpriority="high" /><span class="image-tag">KEEP MOVING <span aria-hidden="true">✦</span></span></div>
      </section>
      <section class="intro-section" aria-labelledby="intro-title">
        <div class="wrap intro-grid"><div><span class="eyebrow">01 / ABOUT THIS SPACE</span><h2 id="intro-title">A little curiosity<br/>goes a long way.</h2></div><div class="intro-description"><p>This is my little space to share projects, lessons from building things, and the occasional thought from everyday life.</p><p>One small step at a time, at my own pace.</p><a class="text-link" href="/about/">Get to know me <span aria-hidden="true">↗</span></a></div></div>
      </section>
      <section class="projects-section wrap" aria-labelledby="projects-title">
        <div class="section-top">
          <div>
            <span class="eyebrow">02 / PROJECTS</span>
            <h2 id="projects-title">Things I'm building<span class="period">.</span></h2>
          </div>
          <a class="text-link" href="/projects/">See all projects <span aria-hidden="true">→</span></a>
        </div>
        <div class="project-grid">
          {topProjects.map((project) => <ProjectCard project={project} />)}
        </div>
      </section>
      <section class="notes-section wrap" aria-labelledby="notes-title">
        <div class="section-top">
          <div>
            <span class="eyebrow">03 / JOURNAL</span>
            <h2 id="notes-title">Recent notes<span class="period">.</span></h2>
          </div>
          <a class="text-link" href="/blog/">View all <span aria-hidden="true">→</span></a>
        </div>
        {recentPosts.length > 0 ? (
          <div class="recent-posts">
            {recentPosts.map((post) => (
              <a class="recent-post" href={`/blog/${post.id}/`}>
                <div class="recent-post-content">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {new Intl.DateTimeFormat('en-US', { dateStyle: 'medium' }).format(post.data.pubDate)}
                  </time>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                </div>
                <span class="recent-post-arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        ) : (
          <div class="empty-notes">
            <span class="empty-icon" aria-hidden="true">✎</span>
            <div>
              <h3>New stories are on their way.</h3>
              <p>Nothing here just yet. Check back soon!</p>
            </div>
            <span class="empty-side">STAY TUNED ↗</span>
          </div>
        )}
      </section>
    </main>
    <Footer />
  </body>
</html>
<style>
  .projects-section {
    padding: 116px 0 0;
  }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  @media (max-width: 850px) {
    .projects-section {
      padding-top: 80px;
    }
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
  .recent-posts {
    border-top: 1px solid #e5e7dd;
  }
  .recent-post {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 27px 18px;
    border-bottom: 1px solid #e5e7dd;
    transition: background-color 0.2s ease;
  }
  .recent-post:hover {
    background: #f3f5ed;
  }
  .recent-post-content {
    min-width: 0;
  }
  .recent-post time {
    display: block;
    margin-bottom: 10px;
    color: #84957a;
    font-family: 'DM Sans', sans-serif;
    font-size: 11px;
  }
  .recent-post h3 {
    margin: 0 0 8px;
    font-size: 19px;
    letter-spacing: -0.5px;
    line-height: 1.4;
  }
  .recent-post p {
    margin: 0;
    color: #858b80;
    font-size: 13px;
    line-height: 1.7;
  }
  .recent-post-arrow {
    flex: none;
    color: #799070;
    font-size: 23px;
  }
  @media (max-width: 480px) {
    .recent-post {
      gap: 14px;
      padding: 24px 4px;
    }
    .recent-post h3 {
      font-size: 17px;
    }
  }
</style>

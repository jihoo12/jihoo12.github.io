---
// Cloud Hop: an obstacle course in the sky with Nixchan, the first game made with Nixkit
// (src/lib/nixkit). The game is src/lib/cloudhop/course.ts; the kit makes its HUD itself.
import BaseHead from '../../components/BaseHead.astro';
import nixModel from '../../assets/nixchan/nixchan-3d.glb?url';

const title = 'Cloud Hop (experimental)';
const description = 'An obstacle course in the sky with Nixchan: hop, dodge the lava, ride the platforms and glide down to the golden arch. Made with Nixkit.';
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<meta name="robots" content="noindex" />
	</head>
	<body class="hop">
		<canvas class="stage" data-stage data-model={nixModel} aria-label="Nixchan on an obstacle course in the sky"></canvas>

		<header class="bar">
			<a class="brand" href="/">jihoo<span class="period">.</span></a>
			<span class="badge">cloud hop · made with nixkit</span>
			<span class="spacer"></span>
			<a class="pill" href="/gallery/?from=cloudhop">Gallery</a>
			<button class="pill" type="button" data-restart aria-label="Start over (R)">Restart</button>
			<button class="pill clock" type="button" data-clock aria-label="Switch between day and night"><span class="sun" aria-hidden="true">☀</span><span class="moon" aria-hidden="true">☾</span></button>
		</header>

		<p class="keys-hint"><kbd>WASD</kbd> move · <kbd>Shift</kbd> run · <kbd>Space</kbd> jump · drag to look · <kbd>R</kbd> restart</p>
		<p class="loading" data-loading>Nixchan is on her way up…</p>
		<noscript><p class="loading">Cloud Hop needs JavaScript to run.</p></noscript>
	</body>
</html>

<script>
	import { startCloudHop } from '../../lib/cloudhop/course';

	const button = document.querySelector<HTMLButtonElement>('[data-clock]');
	button?.addEventListener('click', () => {
		const next = document.documentElement.dataset.time === 'night' ? 'day' : 'night';
		document.documentElement.dataset.time = next;
		try {
			localStorage.setItem('time', next);
		} catch {
			// The choice just won't be remembered.
		}
		window.dispatchEvent(new Event('site-time'));
		button.blur();
	});

	startCloudHop();
</script>

<style>
	:global(html:has(body.hop)), :global(body.hop) { overflow: hidden; height: 100%; }
	:global(body.hop::before), :global(body.hop::after) { display: none; }
	:global(body.hop) { background: var(--bg); -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; }

	.stage { position: fixed; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; cursor: grab; }
	.stage:active { cursor: grabbing; }
	:global(.no-3d) .stage { display: none; }

	.bar {
		position: fixed; z-index: 30; top: 0; left: 0; right: 0;
		display: flex; align-items: center; gap: 10px; padding: 14px 16px;
		pointer-events: none;
	}
	.bar > * { pointer-events: auto; }
	.brand { font-family: var(--display); font-size: 28px; line-height: 1; color: var(--ink); }
	.badge { background: var(--star); color: #1c1a3e; font-size: 12px; font-weight: 900; padding: 3px 10px; border-radius: 999px; transform: rotate(-3deg); white-space: nowrap; }
	.spacer { flex: 1; }
	.pill {
		border: 0; border-radius: 9px; padding: 8px 13px; background: var(--surface); color: var(--ink);
		font: 800 15px var(--sans); box-shadow: 0 4px 0 var(--edge); cursor: pointer; text-decoration: none;
	}
	.pill:hover { transform: translateY(-2px); }
	.clock .moon, :global([data-time='night']) .clock .sun { display: none; }
	:global([data-time='night']) .clock .moon { display: inline; }

	.keys-hint {
		position: fixed; z-index: 20; left: 16px; bottom: 16px; margin: 0; padding: 6px 12px; border-radius: 10px;
		background: color-mix(in srgb, var(--surface) 85%, transparent); color: var(--muted); font-size: 13px; font-weight: 800;
		pointer-events: none;
	}
	.keys-hint kbd { font: inherit; color: var(--ink); }
	@media (pointer: coarse) { .keys-hint { display: none; } }

	.loading {
		position: fixed; z-index: 40; inset: 0; display: grid; place-items: center; margin: 0;
		background: var(--bg); color: var(--ink); font-family: var(--display); font-size: 24px; text-align: center; padding: 16px;
	}
	.loading[hidden] { display: none; }

	@media (max-width: 560px) {
		.badge { display: none; }
		.pill { padding: 7px 10px; font-size: 14px; }
	}
</style>

---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import hugArt from '../assets/nixchan/nixchan-penguin-hug-01.png';
---
<!doctype html><html lang="en"><head><BaseHead title="About — Jihoo" description="A little more about Jihoo." /></head><body><Header/><main class="wrap about-main"><span class="eyebrow">NICE TO MEET YOU</span><div class="about-layout"><div><h1>Hello,<br/>I'm Jihoo<span class="period">.</span></h1><p>I love learning new things and turning ideas into something real. This is where I collect lessons from coding, creative experiments, and everyday discoveries.</p><p>I believe in steady progress over perfection, and clarity over complexity.</p><a class="button primary" href="https://github.com/jihoo12" target="_blank" rel="noopener noreferrer">Find me on GitHub ↗</a></div><div class="art"><Image src={hugArt} alt="Nixchan happily hugging a penguin" width={600} loading="eager" /><span class="tag">HI THERE <span aria-hidden="true">♡</span></span></div></div></main><Footer/></body></html><style>.about-main{padding-top:100px;padding-bottom:140px;min-height:75vh}.about-layout{display:grid;grid-template-columns:1fr .8fr;align-items:center;gap:100px;margin-top:24px}.about-layout h1{font-size:clamp(43px,6vw,70px);line-height:1.15;margin:0 0 30px}.about-layout p{font-size:16px;color:var(--muted);line-height:1.9;margin:0 0 17px}.about-layout .button{margin-top:26px}@media(max-width:760px){.about-main{padding-top:70px;padding-bottom:90px}.about-layout{grid-template-columns:1fr;gap:45px}.about-layout .art{max-width:420px}}</style>

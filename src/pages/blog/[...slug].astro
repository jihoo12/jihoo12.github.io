---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const translated = new Set((await getCollection('blogKo')).map((p) => p.id));
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post, hasKo: translated.has(post.id) },
	}));
}
type Props = { post: CollectionEntry<'blog'>; hasKo: boolean };

const { post, hasKo } = Astro.props;
const { Content, headings } = await render(post);
---

<BlogPost {...post.data} headings={headings} versions={hasKo ? { en: `/blog/${post.id}/`, ko: `/ko/blog/${post.id}/` } : undefined}>
	<Content />
</BlogPost>

---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<!doctype html><html lang="ko"><head><BaseHead title="Journal — Jihoo" description="개발과 일상의 작은 기록을 모았습니다." /></head><body><Header/><main class="wrap journal-main"><span class="eyebrow">THOUGHTS & NOTES</span><h1>나의 기록<span class="period">.</span></h1><p class="journal-subtitle">배운 것과 경험한 것을 한 페이지씩 남깁니다.</p>{posts.length>0 ? <div class="post-list">{posts.map(post=><a class="post" href={`/blog/${post.id}/`}><div><span class="post-date">{new Intl.DateTimeFormat('ko-KR',{dateStyle:'medium'}).format(post.data.pubDate)}</span><h2>{post.data.title}</h2><p>{post.data.description}</p></div><span class="post-arrow" aria-hidden="true">↗</span></a>)}</div> : <div class="journal-empty"><span aria-hidden="true">✳</span><h2>아직 작성된 글이 없어요.</h2><p>새로운 이야기가 시작되면 이곳에서 만날 수 있어요.</p><a class="text-link" href="/">홈으로 돌아가기 →</a></div>}</main><Footer/></body></html><style>.journal-main{min-height:72vh;padding-top:110px;padding-bottom:130px}.journal-main h1{font-size:clamp(48px,6vw,70px);letter-spacing:-3px;line-height:1.2;margin:25px 0 16px}.journal-subtitle{color:#777e71;font-size:15px}.post-list{margin-top:65px;border-top:1px solid #dfe5d8}.post{display:flex;align-items:center;justify-content:space-between;padding:27px 8px;border-bottom:1px solid #dfe5d8}.post h2{font-size:23px;margin:9px 0 8px}.post p{font-size:13px;color:#858b80;margin:0}.post-date{font-family:'DM Sans',sans-serif;font-size:11px;color:#84957a}.post-arrow{font-size:22px;color:#799070}.journal-empty{margin-top:70px;padding:65px 25px;text-align:center;border:1px dashed #cbd7c0;border-radius:13px;background:#f4f6ef}.journal-empty>span{font-size:38px;color:#92a783}.journal-empty h2{font-size:21px;margin:12px 0}.journal-empty p{font-size:14px;color:#7b8677;margin-bottom:25px}@media(max-width:600px){.journal-main{padding-top:76px;padding-bottom:95px}}</style>
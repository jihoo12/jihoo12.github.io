---
import { Image } from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import headerArt from '../../assets/nixchan/nixchan-rainy-coding-01.png';
import fallbackArt from '../../assets/nixchan/nixchan-night-coffee-01.png';
import emptyArt from '../../assets/nixchan/nixchan-penguin-nap-01.png';

const koIds = new Set((await getCollection('blogKo')).map((p) => p.id));
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const dateLabel = new Intl.DateTimeFormat('en-US', { dateStyle: 'medium' });
---
<!doctype html>
<html lang="en">
  <head><BaseHead title="Journal — Jihoo" description="Notes on code, curiosity, and everyday life." /></head>
  <body>
    <Header />
    <main class="wrap journal-main">
      <div class="page-head">
        <div>
          <span class="eyebrow">THOUGHTS & NOTES</span>
          <h1>The journal<span class="period">.</span></h1>
          <p class="journal-subtitle">Thoughts, discoveries, and the things I'm learning along the way.</p>
        </div>
        <div class="art"><Image src={headerArt} alt="Nixchan coding by a rainy window at night" width={600} loading="eager" /></div>
      </div>
      {posts.length > 0 ? (
        <div class="prints">
          {posts.map((post, i) => (
            <a class:list={['print', { latest: i === 0 }]} href={`/blog/${post.id}/`}>
              <Image class="print-art" src={post.data.heroImage ?? fallbackArt} alt="" width={i === 0 ? 720 : 480} height={i === 0 ? 720 : 480} loading={i < 3 ? 'eager' : 'lazy'} />
              <div class="print-body">
                <span class="print-meta">
                  {i === 0 && <span class="print-new">Latest</span>}
                  <time datetime={post.data.pubDate.toISOString()}>{dateLabel.format(post.data.pubDate)}</time>
                  {koIds.has(post.id) && <span class="print-lang" lang="ko" title="한국어 번역이 있어요">한국어</span>}
                </span>
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
                {i === 0 && <span class="text-link">Read the note <span aria-hidden="true">→</span></span>}
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="journal-empty">
          <Image src={emptyArt} alt="Nixchan napping with a penguin" width={320} />
          <h2>It's a little quiet here.</h2>
          <p>I'm working on my first note. See you soon!</p>
          <a class="text-link" href="/">Back to home →</a>
        </div>
      )}
    </main>
    <Footer />
  </body>
</html>
<style>
  .journal-main { min-height: 72vh; padding-top: 80px; padding-bottom: 130px; }
  .page-head { display: grid; grid-template-columns: 1fr 300px; gap: 60px; align-items: center; }
  .journal-main h1 { font-size: clamp(48px, 6vw, 70px); line-height: 1.15; margin: 25px 0 16px; }
  .journal-subtitle { margin: 0; color: var(--muted); font-size: 17px; font-weight: 600; line-height: 1.7; }

  /* Every note is a print taped to the wall, each a little crooked until you reach for it. */
  .prints { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 44px 30px; margin-top: 84px; }
  .print {
    position: relative; display: flex; flex-direction: column; gap: 16px;
    padding: 12px 12px 20px; background: var(--surface); border-radius: 5px;
    box-shadow: 0 18px 30px -14px var(--shadow);
    transform: rotate(var(--tilt, 0deg));
    transition: transform .22s cubic-bezier(.3, 1.5, .5, 1), box-shadow .22s;
  }
  .print:nth-child(4n + 1) { --tilt: -1.1deg; }
  .print:nth-child(4n + 2) { --tilt: .9deg; }
  .print:nth-child(4n + 3) { --tilt: -.5deg; }
  .print:nth-child(4n + 4) { --tilt: 1.3deg; }
  .print::before {
    content: ''; position: absolute; z-index: 1; top: -11px; left: 50%; width: 84px; height: 24px; margin-left: -42px;
    background: color-mix(in srgb, var(--star) 72%, transparent); transform: rotate(-3deg);
  }
  .print:nth-child(even)::before { left: 32%; transform: rotate(2.5deg); }
  .print:hover, .print:focus-visible { transform: rotate(0) translateY(-6px); box-shadow: 0 28px 36px -16px var(--shadow); }
  .print-art { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: 2px; }
  .print-body { display: flex; flex-direction: column; align-items: flex-start; padding: 0 8px; }
  .print-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; color: var(--accent); font-size: 13px; font-weight: 800; }
  .print-lang { font-size: 11px; background: var(--accent-soft); border-radius: 999px; padding: 1px 8px; }
  .print-new { background: var(--star); color: #1c1a3e; border-radius: 999px; padding: 2px 10px; font-weight: 900; }
  .print h2 { margin: 6px 0 8px; font-size: 20px; font-weight: 900; line-height: 1.28; text-wrap: balance; }
  .print p { margin: 0; color: var(--muted); font-size: 14.5px; line-height: 1.55; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; line-clamp: 3; overflow: hidden; }

  /* The newest note is the big print. */
  .print.latest { grid-column: span 2; flex-direction: row; align-items: center; gap: 28px; padding: 14px 28px 14px 14px; --tilt: -.6deg; }
  .latest .print-art { width: 46%; flex: none; }
  .latest .print-body { padding: 0; }
  .latest h2 { margin: 12px 0; font-family: var(--display); font-weight: 400; font-size: clamp(26px, 2.5vw, 33px); line-height: 1.15; }
  .latest p { font-size: 16px; line-height: 1.6; -webkit-line-clamp: 4; line-clamp: 4; }
  .latest .text-link { margin-top: 18px; }
  .print:hover .text-link { gap: 18px; }

  .journal-empty { margin-top: 70px; padding: 50px 25px; text-align: center; border: 1px dashed var(--line); border-radius: 16px; background: var(--bg-tint); }
  .journal-empty img { width: 160px; border-radius: 16px; }
  .journal-empty h2 { font-size: 21px; margin: 12px 0; }
  .journal-empty p { font-size: 14px; color: var(--muted); margin-bottom: 25px; }

  @media (max-width: 980px) {
    .prints { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 760px) {
    .page-head { grid-template-columns: 1fr; gap: 36px; }
    .page-head .art { max-width: 240px; }
  }
  /* On phones the big print stays a print; the rest become slim cards so the list scans quickly. */
  @media (max-width: 600px) {
    .journal-main { padding-top: 56px; padding-bottom: 95px; }
    .prints { grid-template-columns: 1fr; gap: 14px; margin-top: 60px; }
    .print { flex-direction: row; align-items: flex-start; gap: 14px; padding: 12px; --tilt: 0deg !important; border-radius: 12px; box-shadow: 0 5px 0 var(--edge); }
    .print::before { display: none; }
    .print:hover, .print:focus-visible { transform: none; box-shadow: 0 5px 0 var(--edge); }
    .print-art { width: 72px; flex: none; border-radius: 8px; }
    .print-body { padding: 0; min-width: 0; }
    .print h2 { font-size: 17px; margin: 4px 0 5px; }
    .print p { font-size: 14px; -webkit-line-clamp: 2; line-clamp: 2; }
    .print.latest { grid-column: auto; flex-direction: column; align-items: stretch; gap: 16px; padding: 10px 10px 20px; margin-bottom: 18px; --tilt: -.8deg !important; border-radius: 5px; box-shadow: 0 18px 30px -14px var(--shadow); }
    .print.latest::before { display: block; }
    .latest .print-art { width: 100%; border-radius: 2px; }
    .latest .print-body { padding: 0 8px; }
    .latest h2 { font-size: 26px; margin: 10px 0; }
    .latest p { font-size: 15px; -webkit-line-clamp: 3; line-clamp: 3; }
  }
  @media (prefers-reduced-motion: reduce) {
    .print { transition: none; }
    .print:hover, .print:focus-visible { transform: rotate(var(--tilt, 0deg)); }
  }
</style>

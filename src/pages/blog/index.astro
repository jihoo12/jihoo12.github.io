---
import { Image } from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import headerArt from '../../assets/nixchan/nixchan-rainy-coding-01.png';
import fallbackArt from '../../assets/nixchan/nixchan-night-coffee-01.png';
import emptyArt from '../../assets/nixchan/nixchan-penguin-nap-01.png';
const koIds = new Set((await getCollection('blogKo')).map((p) => p.id));
const posts = (await getCollection('blog')).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<!doctype html><html lang="en"><head><BaseHead title="Journal — Jihoo" description="Notes on code, curiosity, and everyday life." /></head><body><Header/><main class="wrap journal-main">
<div class="page-head"><div><span class="eyebrow">THOUGHTS & NOTES</span><h1>The journal<span class="period">.</span></h1><p class="journal-subtitle">Thoughts, discoveries, and the things I'm learning along the way.</p></div><div class="art"><Image src={headerArt} alt="Nixchan coding by a rainy window at night" width={600} loading="eager" /></div></div>
{posts.length>0 ? <div class="post-list">{posts.map(post=><a class="post" href={`/blog/${post.id}/`}><Image class="post-thumb" src={post.data.heroImage ?? fallbackArt} alt="" width={192} height={192} /><div class="post-body"><span class="post-date">{new Intl.DateTimeFormat('en-US',{dateStyle:'medium'}).format(post.data.pubDate)}</span>{koIds.has(post.id) && <span class="post-lang" lang="ko" title="한국어 번역이 있어요">한국어</span>}<h2>{post.data.title}</h2><p>{post.data.description}</p></div><span class="post-arrow" aria-hidden="true">↗</span></a>)}</div> : <div class="journal-empty"><Image src={emptyArt} alt="Nixchan napping with a penguin" width={320} /><h2>It's a little quiet here.</h2><p>I'm working on my first note. See you soon!</p><a class="text-link" href="/">Back to home →</a></div>}
</main><Footer/></body></html>
<style>.journal-main{min-height:72vh;padding-top:80px;padding-bottom:130px}.page-head{display:grid;grid-template-columns:1fr 300px;gap:60px;align-items:center}.journal-main h1{font-size:clamp(48px,6vw,70px);line-height:1.15;margin:25px 0 16px}.journal-subtitle{color:var(--muted);font-size:15px;line-height:1.9}.post-list{margin-top:70px;display:grid;gap:14px}.post{display:flex;align-items:center;gap:26px;padding:18px;background:var(--surface);border-radius:14px;box-shadow:0 5px 0 var(--edge);transition:transform .15s,box-shadow .15s}.post:hover{transform:translateY(-3px);box-shadow:0 8px 0 var(--edge)}.post-thumb{flex:none;width:96px;height:96px;border-radius:12px;object-fit:cover}.post-body{min-width:0;flex:1}.post h2{font-size:21px;font-weight:800;line-height:1.35;margin:7px 0 6px}.post p{font-size:14.5px;line-height:1.7;color:var(--muted);margin:0}.post-date{font-size:13px;font-weight:800;color:var(--accent)}.post-lang{display:inline-block;margin-left:8px;font-size:10px;font-weight:700;color:var(--accent);background:var(--accent-soft);border-radius:999px;padding:1px 8px;vertical-align:1px}.post-arrow{flex:none;font-size:22px;color:var(--accent);padding-right:8px}.journal-empty{margin-top:70px;padding:50px 25px;text-align:center;border:1px dashed var(--line);border-radius:16px;background:var(--bg-tint)}.journal-empty img{width:160px;border-radius:16px}.journal-empty h2{font-size:21px;margin:12px 0}.journal-empty p{font-size:14px;color:var(--muted);margin-bottom:25px}@media(max-width:760px){.page-head{grid-template-columns:1fr;gap:36px}.page-head .art{max-width:240px}}@media(max-width:600px){.journal-main{padding-top:56px;padding-bottom:95px}.post{align-items:start;gap:16px;padding:14px}.post-thumb{width:64px;height:64px}.post-arrow{display:none}.post h2{font-size:17px}}</style>

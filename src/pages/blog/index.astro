---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<!doctype html>
<html lang="en">
  <head><BaseHead title="Notebook | Jihoo" description="An index of Jihoo's notes on code, ideas, experiments, and the process of learning." /></head>
  <body>
    <Header />
    <main class="wrap journal-main" id="main-content">
      <section class="page-lead" aria-labelledby="journal-title">
        <span class="eyebrow">ARCHIVE / NOTES & OBSERVATIONS</span>
        <h1 id="journal-title">The <em>notebook.</em></h1>
        <p>A chronological index of observations, technical explorations, and the occasional unfinished thought.</p>
      </section>
      <section class="journal-index" aria-label="Notebook entries">
        <div class="journal-index-header"><span>CATALOGUE / {posts.length.toString().padStart(2, '0')} ENTRIES</span><span>ORDERED BY DATE ↓</span></div>
        {posts.length > 0 ? (
          <div class="catalogue">
            {posts.map((post) => (
              <a class="catalogue-row" href={'/blog/' + post.id + '/'}>
                <time datetime={post.data.pubDate.toISOString()}>{new Intl.DateTimeFormat('en-US', { dateStyle: 'medium' }).format(post.data.pubDate)}</time>
                <div><h3>{post.data.title}</h3><p>{post.data.description}</p></div>
                <span class="arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        ) : (
          <div class="journal-empty">
            <span class="no">NO. 000</span>
            <div><h2>Entries are forthcoming.</h2><p>The catalogue is currently empty. Published notes will be listed here with their dates and descriptions.</p><a class="text-link" href="/">Return to index <span aria-hidden="true">↗</span></a></div>
          </div>
        )}
      </section>
    </main>
    <Footer />
  </body>
</html>

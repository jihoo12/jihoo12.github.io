---
// A page for each game in src/games/<id>/, at /play/<id>/ (see CONTRIBUTING.md). Not /games/<id>/:
// the jihoo12/games repository is published on GitHub Pages at jihoo12.github.io/games/, which
// wins over this site's own pages there. Its meta.ts says what it's called
// and who made it; its game.ts runs in the browser (lib/nixkit/runner.ts), and the kit makes the HUD.
import BaseHead from '../../components/BaseHead.astro';
import nixModel from '../../assets/nixchan/nixchan-3d.glb?url';
import type { GameMeta } from '../../lib/nixkit/meta';

export function getStaticPaths() {
	const metas = import.meta.glob<{ default: GameMeta }>('../../games/*/meta.ts', { eager: true });
	return Object.entries(metas)
		.map(([path, mod]) => ({ id: path.split('/').at(-2)!, meta: mod.default }))
		.filter(({ id }) => !id.startsWith('_'))
		.map(({ id, meta }) => ({ params: { id }, props: { meta } }));
}

const { id } = Astro.params;
const { meta } = Astro.props;
const title = `${meta.title} (experimental)`;
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={meta.description} />
		<meta name="robots" content="noindex" />
	</head>
	<body class="play">
		<canvas class="stage" data-stage data-model={nixModel} data-game={id} aria-label={`${meta.title}, a game with Nixchan`}></canvas>

		<header class="bar">
			<a class="brand" href="/">jihoo<span class="period">.</span></a>
			<span class="badge">{meta.title.toLowerCase()} · by {meta.github ? <a href={`https://github.com/${meta.github}`} target="_blank" rel="noopener noreferrer">{meta.author}</a> : meta.author}</span>
			<span class="spacer"></span>
			<a class="pill" href={`/gallery/?from=${id}`}>Gallery</a>
			<button class="pill clock" type="button" data-clock aria-label="Switch between day and night"><span class="sun" aria-hidden="true">☀</span><span class="moon" aria-hidden="true">☾</span></button>
		</header>

		<p class="keys-hint"><kbd>WASD</kbd> move · <kbd>Shift</kbd> run · <kbd>Space</kbd> jump · drag to look{meta.keys && ` · ${meta.keys}`}</p>
		<p class="loading" data-loading>Nixchan is on her way…</p>
		<noscript><p class="loading">{meta.title} needs JavaScript to run.</p></noscript>
	</body>
</html>

<script>
	import { runGame } from '../../lib/nixkit/runner';

	const button = document.querySelector<HTMLButtonElement>('[data-clock]');
	button?.addEventListener('click', () => {
		const next = document.documentElement.dataset.time === 'night' ? 'day' : 'night';
		document.documentElement.dataset.time = next;
		try {
			localStorage.setItem('time', next);
		} catch {
			// The choice just won't be remembered.
		}
		window.dispatchEvent(new Event('site-time'));
		button.blur();
	});

	const id = document.querySelector<HTMLCanvasElement>('[data-stage]')?.dataset.game;
	if (id) runGame(id);
</script>

<style>
	:global(html:has(body.play)), :global(body.play) { overflow: hidden; height: 100%; }
	:global(body.play::before), :global(body.play::after) { display: none; }
	:global(body.play) { background: var(--bg); -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; }

	.stage { position: fixed; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; cursor: grab; }
	.stage:active { cursor: grabbing; }
	:global(.no-3d) .stage { display: none; }

	.bar {
		position: fixed; z-index: 30; top: 0; left: 0; right: 0;
		display: flex; align-items: center; gap: 10px; padding: 14px 16px;
		pointer-events: none;
	}
	.bar > * { pointer-events: auto; }
	.brand { font-family: var(--display); font-size: 28px; line-height: 1; color: var(--ink); }
	.badge { background: var(--star); color: #1c1a3e; font-size: 12px; font-weight: 900; padding: 3px 10px; border-radius: 999px; transform: rotate(-3deg); white-space: nowrap; }
	.badge a { color: inherit; }
	.spacer { flex: 1; }
	.pill {
		border: 0; border-radius: 9px; padding: 8px 13px; background: var(--surface); color: var(--ink);
		font: 800 15px var(--sans); box-shadow: 0 4px 0 var(--edge); cursor: pointer; text-decoration: none;
	}
	.pill:hover { transform: translateY(-2px); }
	.clock .moon, :global([data-time='night']) .clock .sun { display: none; }
	:global([data-time='night']) .clock .moon { display: inline; }

	.keys-hint {
		position: fixed; z-index: 20; left: 16px; bottom: 16px; margin: 0; padding: 6px 12px; border-radius: 10px;
		background: color-mix(in srgb, var(--surface) 85%, transparent); color: var(--muted); font-size: 13px; font-weight: 800;
		pointer-events: none;
	}
	.keys-hint kbd { font: inherit; color: var(--ink); }
	@media (pointer: coarse) { .keys-hint { display: none; } }

	.loading {
		position: fixed; z-index: 40; inset: 0; display: grid; place-items: center; margin: 0;
		background: var(--bg); color: var(--ink); font-family: var(--display); font-size: 24px; text-align: center; padding: 16px;
	}
	.loading[hidden] { display: none; }

	@media (max-width: 560px) {
		.badge { display: none; }
		.pill { padding: 7px 10px; font-size: 14px; }
	}
</style>

---
// Nixchan's island: a little open world where the 3D Nixchan roams an island and the sea round it.
import BaseHead from '../../components/BaseHead.astro';
import nixModel from '../../assets/nixchan/nixchan-3d.glb?url';
import fishModel from '../../assets/island/fish.glb?url';
import farmModel from '../../assets/island/farm.glb?url';
import otterModel from '../../assets/island/otter.glb?url';
import skyModel from '../../assets/island/sky.glb?url';
import forgeModel from '../../assets/island/forge.glb?url';

const title = "Nixchan's island (experimental)";
const description = "Roam a little toon island with Nixchan: climb, swim, glide, fish, grow a garden and find what's out there.";
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<meta name="robots" content="noindex" />
	</head>
	<body class="isle">
		<canvas class="stage" data-stage data-model={nixModel} data-fish-model={fishModel} data-farm-model={farmModel} data-otter-model={otterModel} data-sky-model={skyModel} data-forge-model={forgeModel} aria-label="Nixchan on her island"></canvas>

		<header class="bar">
			<a class="brand" href="/">jihoo<span class="period">.</span></a>
			<span class="badge">island · experimental</span>
			<span class="spacer"></span>
			<button class="pill" type="button" data-open="bag" aria-label="Bag (I)">Bag</button>
			<button class="pill help" type="button" data-open="help" aria-label="Help (H)">?</button>
			<a class="pill" href="/experimental/">3D home</a>
			<button class="pill clock" type="button" data-clock aria-label="Switch between day and night"><span class="sun" aria-hidden="true">☀</span><span class="moon" aria-hidden="true">☾</span></button>
		</header>

		<div class="banner" data-banner aria-live="polite">
			<p class="banner-name" data-banner-name></p>
			<p class="banner-note" data-banner-note hidden></p>
		</div>
		<canvas class="map" data-map width="150" height="150" role="button" aria-label="Open the map"></canvas>

		<p class="fish-prompt" data-fish-prompt hidden><kbd>F</kbd> Cast a line</p>
		<p class="fish-prompt act-prompt" data-act-prompt hidden><kbd>E</kbd><span data-act-text></span></p>
		<button class="act" type="button" data-act hidden>Do</button>
		<button class="fish" type="button" data-fish aria-label="Fish">Fish</button>
		<p class="bite" data-bite hidden aria-hidden="true">!</p>
		<div class="reel" data-reel hidden role="status">
			<p class="reel-note" data-reel-note>Keep it steady…</p>
			<div class="tension" data-tension aria-hidden="true"><span class="zone"></span><span class="needle"></span></div>
			<div class="progress" data-progress aria-hidden="true"><span></span></div>
			<p class="reel-hint"><span class="keys">Hold <kbd>F</kbd> to reel in, let go to ease off</span><span class="touch">Hold Reel to reel in, let go to ease off</span></p>
		</div>
		<div class="smith" data-smith hidden role="status">
			<p class="reel-note" data-smith-note>Strike when the marker's in the glow!</p>
			<div class="smith-bar" data-smith-bar aria-hidden="true"><span class="glow"></span><span class="sweet"></span><span class="marker"></span></div>
			<p class="smith-marks" data-smith-marks aria-label="Strikes">○ ○ ○</p>
			<p class="reel-hint"><span class="keys">Press <kbd>E</kbd> to strike</span><span class="touch">Tap Strike! to strike</span></p>
		</div>
		<div class="catch" data-catch aria-live="polite">
			<p class="catch-name" data-catch-name></p>
			<p class="catch-size" data-catch-size></p>
			<p class="catch-note" data-catch-note hidden></p>
		</div>
		<p class="fish-toast" data-fish-toast aria-live="polite"></p>
		<p class="bubble" data-bubble hidden aria-live="polite"></p>
		<div class="talk" data-talk hidden role="dialog" aria-label="Talking with Pebble">
			<p class="talk-name">Pebble</p>
			<p class="talk-text" data-talk-text aria-live="polite"></p>
			<div class="talk-choices" data-talk-choices></div>
		</div>

		<div class="stick" data-stick hidden aria-hidden="true"><div class="knob" data-knob></div></div>
		<button class="jump" type="button" data-jump aria-label="Jump">⤒</button>

		<div class="atlas" data-atlas hidden role="dialog" aria-modal="true" aria-labelledby="atlas-title">
			<div class="atlas-card">
				<h2 id="atlas-title" class="sr-only">Menu</h2>
				<div class="tabs" role="tablist">
					<button type="button" role="tab" aria-selected="false" data-tab="bag">Bag</button>
					<button type="button" role="tab" aria-selected="true" data-tab="map">Map</button>
					<button type="button" role="tab" aria-selected="false" data-tab="fish">Fish book</button>
					<button type="button" role="tab" aria-selected="false" data-tab="help">Help</button>
				</div>
				<div data-panel="bag" hidden>
					<div class="bag" data-bag></div>
					<div class="bag-detail" data-bag-detail aria-live="polite"></div>
					<p class="atlas-count" data-bag-summary></p>
				</div>
				<div data-panel="map">
					<canvas class="atlas-map" data-atlas-map width="560" height="560" aria-hidden="true"></canvas>
					<p class="atlas-count" data-atlas-count></p>
				</div>
				<div data-panel="fish" hidden>
					<ul class="fishbook" data-fishbook></ul>
					<p class="atlas-count" data-fishbook-count></p>
				</div>
				<div class="help" data-panel="help" hidden>
					<section>
						<h3>Getting about</h3>
						<dl class="keys">
							<dt><kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd></dt><dd>Walk (or the arrow keys)</dd>
							<dt><kbd>Shift</kbd></dt><dd>Run</dd>
							<dt><kbd>Space</kbd></dt><dd>Jump, or spring up out of the water</dd>
							<dt><kbd>Space</kbd> again</dt><dd>Open the glider in mid-air, and once more to fold it</dd>
							<dt>Drag</dt><dd>Look around; the scroll wheel zooms</dd>
							<dt><kbd>E</kbd></dt><dd>Plant, water, harvest or use what's in front of you; otherwise wave</dd>
						</dl>
						<dl class="touch">
							<dt>Left thumb</dt><dd>Walk; push far to run</dd>
							<dt>Drag the right</dt><dd>Look around</dd>
							<dt>⤒</dt><dd>Jump; tap again in mid-air to glide</dd>
						</dl>
						<p>Wade into the shallows, or swim out to sea. High ground makes a good place to glide from, and the wind at the Windspout carries a glider straight up.</p>
					</section>
					<section>
						<h3>Fishing</h3>
						<ol>
							<li>Stand at the water's edge or on the pier, facing the sea, and press <kbd class="keys">F</kbd><span class="touch">Fish</span> to cast.</li>
							<li>When the bobber dunks under and a <strong>!</strong> pops up, press it again quickly to hook the fish.</li>
							<li>Hold to reel in and let go to ease off. Keep the needle in the green: too tight and the line snaps, too slack and it gets away.</li>
						</ol>
						<p>Different fish bite at different times and places, and the lake up on Cloudrest has fish of its own. The fish book has a hint for each one you're still missing.</p>
					</section>
					<section>
						<h3>Gardening</h3>
						<ol>
							<li>Nixchan's garden is a short walk inland from the beach where you start. The first time you get there, a watering can and some turnip seeds are waiting.</li>
							<li>Stand on a plot of soil and press <kbd class="keys">E</kbd><span class="touch">the action button</span> to plant a seed, water it, and harvest it when it's ripe.</li>
							<li>A crop grows one stage at a time (sprout, leaves, ripe), and only while the soil is wet, so water it again after each stage. Fill the can at the barrel.</li>
							<li>Pebble the otter keeps the market stand. Talk to her there to sell fish and crops for coins and buy more seeds, or ask her for a tip. Pumpkins take longest and fetch the most; strawberries keep fruiting.</li>
						</ol>
						<p>The garden keeps growing while you're away.</p>
					</section>
					<section>
						<h3>The forge</h3>
						<ol>
							<li>The Old Forge is a short walk from the garden. Iron ore crops out of glinting rocks up in the hills: stand by one and press <kbd class="keys">E</kbd><span class="touch">the action button</span> to mine it. It grows back after a while.</li>
							<li>At the anvil, press <kbd class="keys">E</kbd><span class="touch">the action button</span> to choose what to make, then strike three times when the marker's in the glow. Three perfect strikes make it especially well.</li>
							<li>Two ore smelt into an ingot. Ingots, and sky shards from Cloudrest, make a sturdier watering can, a sky rod and a sky glider.</li>
							<li>The forge makes machines for the garden too. Set a sprinkler where four plots meet and it keeps them watered; four cover the whole garden. Sprocket, the clockwork helper, picks what's ripe into the crate by the garden and plants the same again from your seeds. Collect the crate with <kbd class="keys">E</kbd><span class="touch">the action button</span>.</li>
						</ol>
					</section>
					<section>
						<h3>Menus</h3>
						<dl class="keys">
							<dt><kbd>I</kbd></dt><dd>Bag: everything you're carrying</dd>
							<dt><kbd>M</kbd></dt><dd>Map: fills in as you explore</dd>
							<dt><kbd>H</kbd></dt><dd>This help</dd>
							<dt><kbd>Esc</kbd></dt><dd>Close</dd>
						</dl>
						<p class="touch">Tap the map or the buttons at the top to open these.</p>
						<p>The ☀ button turns day to night and back, and some things only happen after dark.</p>
					</section>
				</div>
				<button class="button primary" type="button" data-atlas-close>Back to the island</button>
			</div>
		</div>
		<div class="atlas shop" data-shop hidden role="dialog" aria-modal="true" aria-labelledby="shop-title">
			<div class="atlas-card">
				<h2 id="shop-title" class="shop-title">Pebble's stand</h2>
				<p class="coins" data-coins>0 coins</p>
				<div class="shop-columns">
					<section>
						<h3>Seeds</h3>
						<ul class="shop-list" data-shop-buy></ul>
					</section>
					<section>
						<h3>Sell</h3>
						<ul class="shop-list" data-shop-sell></ul>
					</section>
				</div>
				<button class="button primary" type="button" data-shop-close>Back to the garden</button>
			</div>
		</div>
		<div class="atlas shop" data-forge hidden role="dialog" aria-modal="true" aria-labelledby="forge-title">
			<div class="atlas-card">
				<h2 id="forge-title" class="shop-title">The Old Forge</h2>
				<p class="coins">Smelt ore into ingots, and make your tools better.</p>
				<div class="shop-columns forge-columns">
					<section>
						<ul class="shop-list" data-forge-list></ul>
					</section>
				</div>
				<button class="button primary" type="button" data-forge-close>Back to the island</button>
			</div>
		</div>
		<p class="loading" data-loading>Nixchan is on her way…</p>
		<noscript><p class="loading">The island needs JavaScript to run.</p></noscript>
	</body>
</html>

<script>
	import { startIsland } from '../../lib/island/game';

	const button = document.querySelector<HTMLButtonElement>('[data-clock]');
	button?.addEventListener('click', () => {
		const next = document.documentElement.dataset.time === 'night' ? 'day' : 'night';
		document.documentElement.dataset.time = next;
		try {
			localStorage.setItem('time', next);
		} catch {
			// The choice just won't be remembered.
		}
		window.dispatchEvent(new Event('site-time'));
		button.blur();
	});

	startIsland();
</script>

<style>
	:global(html:has(body.isle)), :global(body.isle) { overflow: hidden; height: 100%; }
	:global(body.isle::before), :global(body.isle::after) { display: none; }
	:global(body.isle) { background: var(--bg); }
	/* It's a game, not a page to read: holding a finger on a button (or anywhere) mustn't start a
	   text selection or pop up the long-press menu. */
	:global(body.isle) { -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; }

	.stage { position: fixed; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; cursor: grab; }
	.stage:active { cursor: grabbing; }
	:global(.no-3d) .stage { display: none; }

	.bar {
		position: fixed; z-index: 20; top: 0; left: 0; right: 0;
		display: flex; align-items: center; gap: 12px; padding: 16px clamp(16px, 4vw, 40px);
		pointer-events: none;
	}
	.bar > * { pointer-events: auto; }
	.brand { font-family: var(--display); font-size: 28px; line-height: 1; color: var(--ink); }
	.badge { background: var(--star); color: #1c1a3e; font-size: 12px; font-weight: 900; padding: 3px 10px; border-radius: 999px; transform: rotate(-3deg); }
	.spacer { flex: 1; }
	.pill {
		border: 0; border-radius: 9px; padding: 8px 15px; background: var(--surface); color: var(--ink);
		font: 800 15px var(--sans); box-shadow: 0 4px 0 var(--edge); cursor: pointer;
	}
	.pill:hover { transform: translateY(-2px); }
	.clock .moon, :global([data-time='night']) .clock .sun { display: none; }
	:global([data-time='night']) .clock .moon { display: inline; }

	/* A place's name fades in across the top of the screen as she arrives there. */
	.banner {
		position: fixed; z-index: 20; top: 84px; left: 50%; transform: translate(-50%, -6px);
		width: max-content; max-width: calc(100% - 32px); text-align: center;
		pointer-events: none; opacity: 0; transition: opacity 0.6s, transform 0.6s;
	}
	.banner.show { opacity: 1; transform: translate(-50%, 0); }
	.banner p { margin: 0; }
	.banner-name {
		font-family: var(--display); font-size: clamp(30px, 5vw, 46px); line-height: 1.1; color: #fdfbff;
		text-shadow: 0 2px 0 #2c2a52, 0 0 18px rgba(28, 26, 62, 0.45);
	}
	.banner-note {
		display: inline-block; margin-top: 8px !important; padding: 3px 12px; border-radius: 999px;
		background: var(--star); color: #1c1a3e; font-size: 13px; font-weight: 900;
	}
	.banner-note[hidden] { display: none; }
	.map {
		position: fixed; z-index: 20; right: clamp(16px, 4vw, 40px); bottom: 18px;
		width: 150px; height: 150px; border-radius: 50%; cursor: pointer;
		background: #d6dbe9;
		box-shadow: 0 0 0 4px var(--surface), 0 8px 18px -8px var(--shadow);
	}

	.atlas {
		position: fixed; z-index: 30; inset: 0; display: grid; place-items: center; padding: 16px;
		background: color-mix(in srgb, #1c1a3e 35%, transparent);
	}
	.atlas[hidden] { display: none; }
	.atlas-card {
		width: min(560px, 100%, calc(100dvh - 180px)); min-width: min(280px, 100%); padding: 18px; border-radius: 18px; text-align: center;
		background: color-mix(in srgb, var(--surface) 94%, transparent);
		-webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
		box-shadow: 0 14px 30px -18px var(--shadow);
	}
	.atlas-card h2 { margin: 0 0 12px; font-family: var(--display); font-size: 28px; color: var(--ink); }
	.atlas-map { display: block; width: 100%; aspect-ratio: 1; border-radius: 12px; box-shadow: 0 4px 0 var(--edge); }
	.atlas-count { margin: 14px 0; color: var(--muted); font-size: 15px; font-weight: 800; }

	.jump { display: none; }

	.stick {
		position: fixed; z-index: 25; left: 0; top: 0; width: 0; height: 0; pointer-events: none;
	}
	.stick[hidden] { display: none; }
	.stick::before, .knob {
		content: ''; position: absolute; border-radius: 50%;
	}
	.stick::before {
		left: -60px; top: -60px; width: 120px; height: 120px;
		background: color-mix(in srgb, var(--surface) 45%, transparent); box-shadow: inset 0 0 0 3px var(--surface);
	}
	.knob { left: -26px; top: -26px; width: 52px; height: 52px; background: var(--surface); box-shadow: 0 4px 0 var(--edge); }
	.jump {
		position: fixed; z-index: 25; right: 24px; bottom: 190px; width: 72px; height: 72px; border: 0; border-radius: 50%;
		background: var(--surface); color: var(--ink); font: 900 32px var(--sans); box-shadow: 0 5px 0 var(--edge);
		touch-action: none;
	}
	.jump:active { transform: translateY(3px); box-shadow: 0 2px 0 var(--edge); }

	@media (pointer: coarse) {
		.jump { display: block; }
	}

	.fish-prompt {
		position: fixed; z-index: 20; left: 50%; bottom: 28px; transform: translateX(-50%); margin: 0;
		padding: 7px 14px; border-radius: 999px; pointer-events: none;
		background: var(--surface); color: var(--ink); font-size: 15px; font-weight: 900; box-shadow: 0 4px 0 var(--edge);
	}
	.fish-prompt[hidden] { display: none; }
	.act-prompt.inactive kbd { display: none; }
	.act-prompt.inactive { color: var(--muted); }
	.act {
		display: none; position: fixed; z-index: 25; right: 24px; bottom: 280px; min-width: 72px; height: 52px; padding: 0 16px;
		border: 0; border-radius: 999px; background: var(--star); color: #1c1a3e; font: 900 16px var(--sans);
		box-shadow: 0 5px 0 #c99a2e; touch-action: none;
	}
	.act[hidden] { display: none !important; }
	.act:active { transform: translateY(3px); box-shadow: 0 2px 0 #c99a2e; }

	/* The market stand: seeds to buy on one side, what she has to sell on the other. */
	.shop .atlas-card { width: min(720px, 100%); }
	.shop-title { margin: 0; font-family: var(--display); font-size: 28px; color: var(--ink); }
	.coins { display: inline-block; margin: 6px 0 12px; padding: 3px 14px; border-radius: 999px; background: var(--star); color: #1c1a3e; font-weight: 900; }
	.shop-columns { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; text-align: left; max-height: min(460px, calc(100dvh - 240px)); overflow: auto; }
	.shop-columns h3 { margin: 0 0 8px; font-family: var(--display); font-size: 18px; color: var(--ink); }
	.shop-list { list-style: none; margin: 0; padding: 0 0 4px; display: grid; gap: 8px; }
	.shop-list :global(li) {
		display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-radius: 12px;
		background: var(--surface); box-shadow: 0 3px 0 var(--edge);
	}
	.shop-list :global(.shop-picture) { flex: none; width: 44px; height: 44px; border-radius: 8px; background: center / contain no-repeat; }
	.shop-list :global(.shop-text) { flex: 1; min-width: 0; display: grid; }
	.shop-list :global(strong) { color: var(--ink); font-size: 14px; }
	.shop-list :global(small) { color: var(--muted); font-size: 12px; font-weight: 700; }
	.shop-list :global(button) {
		flex: none; border: 0; border-radius: 9px; padding: 6px 10px; background: var(--bg); color: var(--ink);
		font: 800 13px var(--sans); box-shadow: 0 3px 0 var(--edge); cursor: pointer;
	}
	.shop-list :global(button:disabled) { opacity: 0.45; cursor: default; }
	.shop-list :global(.shop-empty) { color: var(--muted); font-size: 13px; font-weight: 700; }
	@media (max-width: 640px) {
		.shop-columns { grid-template-columns: 1fr; }
	}
	.fish-prompt kbd, .reel-hint kbd {
		display: inline-block; min-width: 1.6em; margin-right: 4px; padding: 1px 5px; border-radius: 5px;
		background: var(--star); color: #1c1a3e; font: 900 12px var(--sans); text-align: center;
	}
	.fish {
		display: none; position: fixed; z-index: 25; right: 108px; bottom: 150px; width: 64px; height: 64px; border: 0; border-radius: 50%;
		background: var(--surface); color: var(--ink); font: 900 15px var(--sans); box-shadow: 0 5px 0 var(--edge);
		touch-action: none; opacity: 0.45;
	}
	.fish.ready { opacity: 1; }
	.fish:active { transform: translateY(3px); box-shadow: 0 2px 0 var(--edge); }

	.bite {
		position: fixed; z-index: 22; left: 0; top: 0; margin: 0; pointer-events: none;
		font-family: var(--display); font-size: 54px; line-height: 1; color: var(--star);
		text-shadow: 0 3px 0 #2c2a52; animation: pop 0.35s ease-out;
	}
	.bite[hidden] { display: none; }
	@keyframes pop { from { scale: 0.3; } 70% { scale: 1.2; } to { scale: 1; } }

	.reel {
		position: fixed; z-index: 22; left: 50%; bottom: 28px; transform: translateX(-50%);
		width: min(360px, calc(100% - 32px)); padding: 12px 16px; border-radius: 14px; text-align: center;
		background: color-mix(in srgb, var(--surface) 90%, transparent);
		-webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); box-shadow: 0 4px 0 var(--edge);
	}
	.reel[hidden] { display: none; }
	.reel p { margin: 0; }
	.reel-note { font: 900 17px var(--sans); color: var(--ink); margin-bottom: 8px !important; }
	.reel-hint { margin-top: 8px !important; color: var(--muted); font-size: 12px; font-weight: 800; }
	.reel-hint .touch { display: none; }
	/* The line's tension: keep the needle in the green, out of the red. */
	.tension {
		--t: 0.4; --lo: 0.25; --hi: 0.85; position: relative; height: 18px; border-radius: 999px; overflow: hidden;
		background: linear-gradient(90deg, #c9d3ff 0 calc(var(--lo) * 100%), #8ee07f calc(var(--lo) * 100%) calc(var(--hi) * 100%), #f25f6b calc(var(--hi) * 100%));
	}
	.tension .needle {
		position: absolute; top: -2px; bottom: -2px; width: 6px; border-radius: 3px; left: calc(var(--t) * (100% - 6px));
		background: #2c2a52; box-shadow: 0 0 0 2px #fdfbff;
	}
	.tension.danger { animation: shake 0.12s infinite; }
	/* Smithing at the anvil: strike when the marker's over the glow, dead centre for a perfect one. */
	.smith {
		/* Up top, out of the way of the anvil and her hammer. */
		position: fixed; z-index: 22; left: 50%; top: 84px; transform: translateX(-50%);
		width: min(360px, calc(100% - 32px)); padding: 12px 16px; border-radius: 14px; text-align: center;
		background: color-mix(in srgb, var(--surface) 90%, transparent);
		-webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); box-shadow: 0 4px 0 var(--edge);
	}
	.smith[hidden] { display: none; }
	.smith p { margin: 0; }
	.smith-bar {
		--m: 0; --sweet: 0.5; --w: 0.22; --pw: 0.07; position: relative; height: 20px; border-radius: 999px; overflow: hidden;

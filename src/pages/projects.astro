---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection, render } from 'astro:content';
import { PROFILES } from '../consts';
import { ACTIVITY_DAYS } from '../lib/activity';
import { featuredProjects } from '../lib/projects';
import { Image } from 'astro:assets';
import roadmapArt from '../assets/nixchan/nixchan-roadmap-01.png';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const picks = await featuredProjects(6);
const featured = await Promise.all(
	picks.map(async (pick) => ({ ...pick, Content: pick.entry && (await render(pick.entry)).Content })),
);
const experiments = projects.filter((p) => !picks.some((pick) => pick.entry?.id === p.id));
---
<!doctype html>
<html lang="en">
	<head><BaseHead title="Projects — Jihoo" description="Languages, operating systems, compositors and small libraries I've been building." /></head>
	<body>
		<Header />
		<main class="wrap projects-main">
			<div class="page-head"><div>
			<span class="eyebrow">THINGS I'M BUILDING</span>
			<h1>Projects<span class="period">.</span></h1>
			<p class="projects-subtitle">Languages, an operating system, a 3D desktop, and a couple of small libraries. <br />Most of them are experiments, and all of them taught me something.</p>
			<div class="profiles">
				<a href={PROFILES.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
				<a href={PROFILES.npm} target="_blank" rel="noopener noreferrer">npm <span aria-hidden="true">↗</span></a>
				<a href={PROFILES.pypi} target="_blank" rel="noopener noreferrer">PyPI <span aria-hidden="true">↗</span></a>
			</div>
			</div><div class="art"><Image src={roadmapArt} alt="Nixchan pointing at a roadmap whiteboard" width={600} loading="eager" /></div></div>

			<section class="featured" aria-label="Featured projects">
				{featured.map(({ data, commits, Content }) =>
					Content ? (
						<ProjectCard project={data} commits={commits} detailed><Content /></ProjectCard>
					) : (
						<ProjectCard project={data} commits={commits} detailed />
					),
				)}
			</section>
			<p class="featured-note">The busiest repos of the last {ACTIVITY_DAYS} days, refreshed daily.</p>

			{experiments.length > 0 && (
				<section class="experiments" aria-labelledby="experiments-title">
					<div class="section-top">
						<div>
							<span class="eyebrow">ALSO TINKERING WITH</span>
							<h2 id="experiments-title">Smaller experiments<span class="period">.</span></h2>
						</div>
						<a class="text-link" href={PROFILES.github} target="_blank" rel="noopener noreferrer">More on GitHub <span aria-hidden="true">↗</span></a>
					</div>
					<div class="experiment-list">
						{experiments.map((project) => (
							<a class="experiment" href={project.data.repo} target="_blank" rel="noopener noreferrer">
								<div>
									<span class="experiment-meta">{project.data.language} · {project.data.status}</span>
									<h3>{project.data.title}</h3>
									<p>{project.data.tagline}</p>
								</div>
								<span class="experiment-arrow" aria-hidden="true">↗</span>
							</a>
						))}
					</div>
				</section>
			)}
		</main>
		<Footer />
	</body>
</html>
<style>
	.page-head {
		display: grid;
		grid-template-columns: 1fr 300px;
		gap: 60px;
		align-items: center;
	}
	.projects-main {
		min-height: 72vh;
		padding-top: 80px;
		padding-bottom: 130px;
	}
	.projects-main h1 {
		font-size: clamp(48px, 6vw, 70px);
		line-height: 1.15;
		margin: 25px 0 16px;
	}
	.projects-subtitle {
		color: var(--muted);
		font-size: 15px;
		line-height: 1.9;
		margin: 0;
	}
	.profiles {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 30px;
	}
	.profiles a {
				font-size: 14px;
		font-weight: 800;
		background: var(--surface);
		padding: 9px 15px;
		border-radius: 9px;
		box-shadow: 0 4px 0 var(--edge);
		transition: background 0.2s;
	}
	.profiles a:hover {
		background: var(--accent-soft);
	}
	.profiles span {
		margin-left: 8px;
		color: var(--accent);
	}
	.featured {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 22px;
		margin-top: 60px;
	}
	.featured-note {
				font-size: 13px;
		color: var(--faint);
		margin: 16px 0 0;
	}
	.experiments {
		margin-top: 110px;
	}
	.experiment-list {
		display: grid;
		gap: 12px;
	}
	.experiment {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		padding: 18px 22px;
		background: var(--surface);
		border-radius: 12px;
		box-shadow: 0 4px 0 var(--edge);
		transition: transform 0.15s;
	}
	.experiment:hover {
		transform: translateY(-2px);
	}
	.experiment-meta {
				font-size: 13px;
		font-weight: 800;
		color: var(--accent);
	}
	.experiment h3 {
		font-size: 19px;
		font-weight: 800;
		margin: 6px 0 4px;
	}
	.experiment p {
		font-size: 14.5px;
		color: var(--muted);
		margin: 0;
		line-height: 1.7;
	}
	.experiment-arrow {
		flex: none;
		font-size: 22px;
		color: var(--accent);
	}
	@media (max-width: 760px) {
		.page-head {
			grid-template-columns: 1fr;
			gap: 36px;
		}
		.page-head .art {
			max-width: 240px;
		}
		.featured {
			grid-template-columns: 1fr;
		}
		.section-top {
			flex-direction: column;
			align-items: start;
			gap: 20px;
		}
	}
	@media (max-width: 600px) {
		.projects-main {
			padding-top: 56px;
			padding-bottom: 95px;
		}
		.projects-subtitle br {
			display: none;
		}
		.experiments {
			margin-top: 80px;
		}
	}
</style>

---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { PROFILES } from '../consts';
import { ACTIVITY_DAYS } from '../lib/activity';
import { rankedProjects } from '../lib/projects';
import { Image } from 'astro:assets';
import roadmapArt from '../assets/nixchan/nixchan-roadmap-01.png';

// Everything here comes from GitHub at build time: the top FEATURED by commits get the big cards,
// the next MORE_EXPERIMENTS are listed below them.
const FEATURED = 6;
const MORE_EXPERIMENTS = 10;
const ranked = await rankedProjects();
const featured = ranked.slice(0, FEATURED);
const experiments = ranked.slice(FEATURED, FEATURED + MORE_EXPERIMENTS);
---
<!doctype html>
<html lang="en">
	<head><BaseHead title="Projects — Jihoo" description="Languages, operating systems, compositors and small libraries I've been building." /></head>
	<body>
		<Header />
		<main class="wrap projects-main">
			<div class="page-head"><div>
			<span class="eyebrow">THINGS I'M BUILDING</span>
			<h1>Projects<span class="period">.</span></h1>
			<p class="projects-subtitle">Languages, an operating system, a 3D desktop, and a couple of small libraries. <br />Most of them are experiments, and all of them taught me something.</p>
			<div class="profiles">
				<a href={PROFILES.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
				<a href={PROFILES.npm} target="_blank" rel="noopener noreferrer">npm <span aria-hidden="true">↗</span></a>
				<a href={PROFILES.pypi} target="_blank" rel="noopener noreferrer">PyPI <span aria-hidden="true">↗</span></a>
			</div>
			</div><div class="art"><Image src={roadmapArt} alt="Nixchan pointing at a roadmap whiteboard" width={600} loading="eager" /></div></div>

			<section class="featured" aria-label="Featured projects">
				{featured.map(({ data, commits }) => (
					<div class="shelf">
						<ProjectCard project={data} commits={commits} detailed />
						<span class="plank"></span>
					</div>
				))}
			</section>
			<p class="featured-note">The busiest repos of the last {ACTIVITY_DAYS} days, straight from GitHub and refreshed daily.</p>

			{experiments.length > 0 && (
				<section class="experiments" aria-labelledby="experiments-title">
					<div class="section-top">
						<div>
							<span class="eyebrow">ALSO TINKERING WITH</span>
							<h2 id="experiments-title">Smaller experiments<span class="period">.</span></h2>
						</div>
						<a class="text-link" href={PROFILES.github} target="_blank" rel="noopener noreferrer">More on GitHub <span aria-hidden="true">↗</span></a>
					</div>
					<div class="experiment-list">
						{experiments.map(({ data, commits }) => (
							<a class="experiment" href={data.repo} target="_blank" rel="noopener noreferrer">
								<div>
									<span class="experiment-meta">{[data.language, `${commits} commits · ${ACTIVITY_DAYS}d`].filter(Boolean).join(' · ')}</span>
									<h3>{data.title}</h3>
									<p>{data.tagline}</p>
								</div>
								<span class="experiment-arrow" aria-hidden="true">↗</span>
							</a>
						))}
					</div>
				</section>
			)}
		</main>
		<Footer />
	</body>
</html>
<style>
	.page-head {
		display: grid;
		grid-template-columns: 1fr 300px;
		gap: 60px;
		align-items: center;
	}
	.projects-main {
		min-height: 72vh;
		padding-top: 80px;
		padding-bottom: 130px;
	}
	.projects-main h1 {
		font-size: clamp(48px, 6vw, 70px);
		line-height: 1.15;
		margin: 25px 0 16px;
	}
	.projects-subtitle {
		color: var(--muted);
		font-size: 17px;
		font-weight: 600;
		line-height: 1.7;
		margin: 0;
	}
	.profiles {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 30px;
	}
	.profiles a {
				font-size: 14px;
		font-weight: 800;
		background: var(--surface);
		padding: 9px 15px;
		border-radius: 9px;
		box-shadow: 0 4px 0 var(--edge);
		transition: background 0.2s;
	}
	.profiles a:hover {
		background: var(--accent-soft);
	}
	.profiles span {
		margin-left: 8px;
		color: var(--accent);
	}
	.featured {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 40px 26px;
		margin-top: 70px;
	}
	/* Each project stands on its own shelf. */
	.shelf {
		display: flex;
		flex-direction: column;
		transition: transform 0.15s;
	}
	.shelf:hover {
		transform: translateY(-4px);
	}
	.shelf :global(.project-card) {
		flex: 1;
		margin-inline: 16px;
		border-radius: 16px 16px 0 0;
		box-shadow: none;
	}
	.shelf :global(.project-card:hover) {
		transform: none;
		box-shadow: none;
	}
	.featured-note {
		font-size: 13px;
		font-weight: 600;
		color: var(--faint);
		margin: 22px 0 0;
	}
	.experiments {
		margin-top: 110px;
	}
	.experiment-list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 16px 20px;
	}
	.experiment {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		padding: 18px 22px;
		background: var(--surface);
		border-radius: 12px;
		box-shadow: 0 4px 0 var(--edge);
		transition: transform 0.15s, box-shadow 0.15s;
	}
	.experiment:hover {
		transform: translateY(-2px);
		box-shadow: 0 6px 0 var(--edge);
	}
	.experiment-arrow {
		transition: transform 0.2s;
	}
	.experiment:hover .experiment-arrow {
		transform: translate(3px, -3px);
	}
	.experiment-meta {
				font-size: 13px;
		font-weight: 800;
		color: var(--accent);
	}
	.experiment h3 {
		font-size: 19px;
		font-weight: 800;
		margin: 6px 0 4px;
	}
	.experiment p {
		font-size: 14.5px;
		color: var(--muted);
		margin: 0;
		line-height: 1.7;
	}
	.experiment-arrow {
		flex: none;
		font-size: 22px;
		color: var(--accent);
	}
	@media (max-width: 760px) {
		.page-head {
			grid-template-columns: 1fr;
			gap: 36px;
		}
		.page-head .art {
			max-width: 240px;
		}
		.featured {
			grid-template-columns: 1fr;
			gap: 30px;
		}
		.shelf :global(.project-card) {
			margin-inline: 10px;
		}
		.experiment-list {
			grid-template-columns: 1fr;
		}
		.section-top {
			flex-direction: column;
			align-items: start;
			gap: 20px;
		}
	}
	@media (max-width: 600px) {
		.projects-main {
			padding-top: 56px;
			padding-bottom: 95px;
		}
		.projects-subtitle br {
			display: none;
		}
		.experiments {
			margin-top: 80px;
		}
	}
</style>

---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { PROFILES } from '../../consts';
import { ACTIVITY_DAYS } from '../../lib/activity';
import { rankedProjects } from '../../lib/projects';
import { Image } from 'astro:assets';
import roadmapArt from '../../assets/nixchan/nixchan-roadmap-01.png';
import { langPaths, ogLocale, pairAlternates, routeLang } from '../../i18n';

export const getStaticPaths = langPaths;
const lang = routeLang(Astro.params.lang);
const ko = lang === 'ko';
const t = ko
	? {
			title: '프로젝트 — Jihoo', description: '제가 만들고 있는 언어, 운영체제, 컴포지터, 그리고 작은 라이브러리들.',
			eyebrow: '만들고 있는 것들', h1: '프로젝트', art: '로드맵 화이트보드를 가리키는 닉스쨩', featured: '대표 프로젝트',
			note: `최근 ${ACTIVITY_DAYS}일 동안 가장 바빴던 리포예요. GitHub에서 바로 가져와 매일 새로 고쳐요.`,
			also: '이것저것 만지작거리는 중', smaller: '작은 실험들', more: 'GitHub에서 더 보기',
			commits: (n: number) => `커밋 ${n} · ${ACTIVITY_DAYS}일`,
		}
	: {
			title: 'Projects — Jihoo', description: "Languages, operating systems, compositors and small libraries I've been building.",
			eyebrow: "THINGS I'M BUILDING", h1: 'Projects', art: 'Nixchan pointing at a roadmap whiteboard', featured: 'Featured projects',
			note: `The busiest repos of the last ${ACTIVITY_DAYS} days, straight from GitHub and refreshed daily.`,
			also: 'ALSO TINKERING WITH', smaller: 'Smaller experiments', more: 'More on GitHub',
			commits: (n: number) => `${n} commits · ${ACTIVITY_DAYS}d`,
		};

// Everything here comes from GitHub at build time: the top FEATURED by commits get the big cards,
// the next MORE_EXPERIMENTS are listed below them.
const FEATURED = 6;
const MORE_EXPERIMENTS = 10;
const ranked = await rankedProjects();
const featured = ranked.slice(0, FEATURED);
const experiments = ranked.slice(FEATURED, FEATURED + MORE_EXPERIMENTS);
---
<!doctype html>
<html lang={lang}>
	<head><BaseHead title={t.title} description={t.description} locale={ogLocale(lang)} alternates={pairAlternates('/projects/')} /></head>
	<body>
		<Header />
		<main class="wrap projects-main">
			<div class="page-head"><div>
			<span class="eyebrow">{t.eyebrow}</span>
			<h1>{t.h1}<span class="period">.</span></h1>
			{ko
				? <p class="projects-subtitle">프로그래밍 언어, 운영체제, 3D 데스크톱, 그리고 작은 라이브러리 몇 개. <br />대부분은 실험이지만, 하나하나 저에게 무언가를 가르쳐 줬어요.</p>
				: <p class="projects-subtitle">Languages, an operating system, a 3D desktop, and a couple of small libraries. <br />Most of them are experiments, and all of them taught me something.</p>}
			<div class="profiles">
				<a href={PROFILES.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
				<a href={PROFILES.npm} target="_blank" rel="noopener noreferrer">npm <span aria-hidden="true">↗</span></a>
				<a href={PROFILES.pypi} target="_blank" rel="noopener noreferrer">PyPI <span aria-hidden="true">↗</span></a>
			</div>
			</div><div class="art"><Image src={roadmapArt} alt={t.art} width={600} loading="eager" /></div></div>

			<section class="featured" aria-label={t.featured}>
				{featured.map(({ data, commits }) => (
					<div class="shelf">
						<ProjectCard project={data} commits={commits} detailed lang={lang} />
						<span class="plank"></span>
					</div>
				))}
			</section>
			<p class="featured-note">{t.note}</p>

			{experiments.length > 0 && (
				<section class="experiments" aria-labelledby="experiments-title">
					<div class="section-top">
						<div>
							<span class="eyebrow">{t.also}</span>
							<h2 id="experiments-title">{t.smaller}<span class="period">.</span></h2>
						</div>
						<a class="text-link" href={PROFILES.github} target="_blank" rel="noopener noreferrer">{t.more} <span aria-hidden="true">↗</span></a>
					</div>
					<div class="experiment-list">
						{experiments.map(({ data, commits }) => (
							<a class="experiment" href={data.repo} target="_blank" rel="noopener noreferrer">
								<div>
									<span class="experiment-meta">{[data.language, t.commits(commits)].filter(Boolean).join(' · ')}</span>
									<h3>{data.title}</h3>
									<p lang="en">{data.tagline}</p>
								</div>
								<span class="experiment-arrow" aria-hidden="true">↗</span>
							</a>
						))}
					</div>
				</section>
			)}
		</main>
		<Footer />
	</body>
</html>
<style>
	.page-head {
		display: grid;
		grid-template-columns: 1fr 300px;
		gap: 60px;
		align-items: center;
	}
	.projects-main {
		min-height: 72vh;
		padding-top: 80px;
		padding-bottom: 130px;
	}
	.projects-main h1 {
		font-size: clamp(48px, 6vw, 70px);
		line-height: 1.15;
		margin: 25px 0 16px;
	}
	.projects-main:lang(ko) .page-head {
		word-break: keep-all;
		overflow-wrap: break-word;
	}
	.projects-subtitle {
		color: var(--muted);
		font-size: 17px;
		font-weight: 600;
		line-height: 1.7;
		margin: 0;
	}
	.profiles {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 30px;
	}
	.profiles a {
				font-size: 14px;
		font-weight: 800;
		background: var(--surface);
		padding: 9px 15px;
		border-radius: 9px;
		box-shadow: 0 4px 0 var(--edge);
		transition: background 0.2s;
	}
	.profiles a:hover {
		background: var(--accent-soft);
	}
	.profiles span {
		margin-left: 8px;
		color: var(--accent);
	}
	.featured {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 40px 26px;
		margin-top: 70px;
	}
	/* Each project stands on its own shelf. */
	.shelf {
		display: flex;
		flex-direction: column;
		transition: transform 0.15s;
	}
	.shelf:hover {
		transform: translateY(-4px);
	}
	.shelf :global(.project-card) {
		flex: 1;
		margin-inline: 16px;
		border-radius: 16px 16px 0 0;
		box-shadow: none;
	}
	.shelf :global(.project-card:hover) {
		transform: none;
		box-shadow: none;
	}
	.featured-note {
		font-size: 13px;
		font-weight: 600;
		color: var(--faint);
		margin: 22px 0 0;
	}
	.experiments {
		margin-top: 110px;
	}
	.experiment-list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 16px 20px;
	}
	.experiment {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		padding: 18px 22px;
		background: var(--surface);
		border-radius: 12px;
		box-shadow: 0 4px 0 var(--edge);
		transition: transform 0.15s, box-shadow 0.15s;
	}
	.experiment:hover {
		transform: translateY(-2px);
		box-shadow: 0 6px 0 var(--edge);
	}
	.experiment-arrow {
		transition: transform 0.2s;
	}
	.experiment:hover .experiment-arrow {
		transform: translate(3px, -3px);
	}
	.experiment-meta {
				font-size: 13px;
		font-weight: 800;
		color: var(--accent);
	}
	.experiment h3 {
		font-size: 19px;
		font-weight: 800;
		margin: 6px 0 4px;
	}
	.experiment p {
		font-size: 14.5px;
		color: var(--muted);
		margin: 0;
		line-height: 1.7;
	}
	.experiment-arrow {
		flex: none;
		font-size: 22px;
		color: var(--accent);
	}
	@media (max-width: 760px) {
		.page-head {
			grid-template-columns: 1fr;
			gap: 36px;
		}
		.page-head .art {
			max-width: 240px;
		}
		.featured {
			grid-template-columns: 1fr;
			gap: 30px;
		}
		.shelf :global(.project-card) {
			margin-inline: 10px;
		}
		.experiment-list {
			grid-template-columns: 1fr;
		}
		.section-top {
			flex-direction: column;
			align-items: start;
			gap: 20px;
		}
	}
	@media (max-width: 600px) {
		.projects-main {
			padding-top: 56px;
			padding-bottom: 95px;
		}
		.projects-subtitle br {
			display: none;
		}
		.experiments {
			margin-top: 80px;
		}
	}
</style>

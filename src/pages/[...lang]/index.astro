---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import NixChan from '../../components/NixChan.astro';
import { getCollection } from 'astro:content';
import { featuredProjects } from '../../lib/projects';
import { ACTIVITY_DAYS } from '../../lib/activity';
import { Image } from 'astro:assets';
import thinkingArt from '../../assets/nixchan/nixchan-math-thinking-01.png';
import { dateLabel as dateFormat, langPaths, localize, ogLocale, pairAlternates, routeLang } from '../../i18n';

export const getStaticPaths = langPaths;
const lang = routeLang(Astro.params.lang);
const ko = lang === 'ko';
const t = ko
  ? {
      title: 'Jihoo — 작은 기록, 새로운 시작', description: '제가 만들고, 배우고, 좋아하는 것들을 모아 둔 인터넷의 작은 구석이에요.', intro: '소개',
      hello: '안녕하세요. 호기심이 이끄는 걸 만들고 배운 걸 적어 두면서, 그 사이사이 작은 것들에서 즐거움을 찾고 있어요.',
      more: '저에 대해 더 보기', read: '저널 읽기',
      spaceArt: '수학 기호가 가득한 칠판 앞에서 생각에 잠긴 닉스쨩', spaceTitle: '작은 호기심이 멀리 데려다줘요',
      spaceText: '프로젝트와 무언가를 만들며 배운 것, 그리고 가끔은 일상의 생각을 나누는 작은 공간이에요. 한 걸음씩, 나만의 속도로.', know: '저에 대해 알아보기',
      builds: '만들고 있는 것들', allProjects: '모든 프로젝트 보기', notes: '최근 글', all: '모두 보기', english: '영어',
    }
  : {
      title: 'Jihoo — Small notes, new beginnings', description: 'A little corner of the internet for things I make, learn, and love.', intro: 'Introduction',
      hello: 'Hey there. I build what sparks my curiosity and write down what I learn, finding joy in the little things along the way.',
      more: 'More about me', read: 'Read the journal',
      spaceArt: 'Nixchan thinking in front of a chalkboard of math symbols', spaceTitle: 'A little curiosity goes a long way',
      spaceText: 'This is my little space to share projects, lessons from building things, and the occasional thought from everyday life. One small step at a time, at my own pace.', know: 'Get to know me',
      builds: "Things I'm building", allProjects: 'See all projects', notes: 'Recent notes', all: 'View all', english: '',
    };

// On the Korean page a post shows its translation when there is one, and the English original otherwise.
const translations = ko ? new Map((await getCollection('blogKo')).map((p) => [p.id, p])) : new Map();
const recentPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)
  .map((post) => {
    const ko = translations.get(post.id);
    return ko
      ? { id: post.id, data: ko.data, href: `/ko/blog/${post.id}/`, lang: 'ko' }
      : { id: post.id, data: post.data, href: `/blog/${post.id}/`, lang: 'en' };
  });

// Busier projects stand taller, on a square-root scale so one huge month doesn't flatten the rest.
const MAX_RISE = 150;
const picks = (await featuredProjects(3)).sort((a, b) => a.commits - b.commits);
const roots = picks.map((p) => Math.sqrt(p.commits));
const low = Math.min(...roots);
const span = Math.max(...roots) - low;
const skyline = picks.map((pick, i) => ({ ...pick, rise: span > 0 ? Math.round(((roots[i] - low) / span) * MAX_RISE) : 0 }));

// Where the top of each glyph sits inside its box, as a fraction of the box height.
const letters = [
  { char: 'j', seat: 0.185 },
  { char: 'i', seat: 0.185, breakAfter: true },
  { char: 'h', seat: 0.153, phone: true },
  { char: 'o', seat: 0.404 },
  { char: 'o', seat: 0.404, start: true },
];
const hanging = [22, 74, 44];
const dateLabel = dateFormat(lang);
---
<!doctype html>
<html lang={lang}>
  <head><BaseHead title={t.title} description={t.description} locale={ogLocale(lang)} alternates={pairAlternates('/')} /></head>
  <body>
    <Header />
    <main>
      <section class="hero wrap" aria-label={t.intro}>
        <h1 class="word" aria-label="Jihoo">
          {letters.map(({ char, seat, start, phone, breakAfter }) => (
            <Fragment>
              <span class="letter" aria-hidden="true" data-nix-perch data-nix-along="0.5" data-nix-seat={seat} data-nix-start={start ? '' : undefined} data-nix-phone={phone ? '' : undefined}>{char}</span>
              {breakAfter && <span class="word-break" aria-hidden="true"></span>}
            </Fragment>
          ))}<span class="dot" aria-hidden="true">.</span>
        </h1>
        <span class="plank hero-plank"></span>
        <div class="intro">
          <p>{t.hello}</p>
          <div class="keys">
            <a class="button primary" href={localize('/about/', lang)}>{t.more}</a>
            <a class="button secondary" href={localize('/blog/', lang)}>{t.read}</a>
          </div>
        </div>
      </section>

      <section class="space wrap" aria-labelledby="space-title">
        <div class="art"><Image src={thinkingArt} alt={t.spaceArt} width={600} /></div>
        <div class="space-text">
          <h2 id="space-title" class="display">{t.spaceTitle}<span class="period">.</span></h2>
          <p>{t.spaceText}</p>
          <a class="text-link" href={localize('/about/', lang)}>{t.know} <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section class="builds wrap" aria-labelledby="projects-title">
        <div class="builds-head">
          <h2 id="projects-title" class="display">{t.builds}<span class="period">.</span></h2>
          {span > 0 && (ko
            ? <p><span class="cap-wide">높을수록</span><span class="cap-narrow">길수록</span> 최근 {ACTIVITY_DAYS}일 동안 더 바빴던 프로젝트예요.</p>
            : <p><span class="cap-wide">Taller</span><span class="cap-narrow">Longer</span> means busier in the last {ACTIVITY_DAYS} days.</p>)}
          <a class="text-link" href={localize('/projects/', lang)}>{t.allProjects} <span aria-hidden="true">→</span></a>
        </div>
        <div class="skyline">
          {skyline.map(({ data, commits, rise }, i) => (
            <div class="stand" style={`--rise:${rise}px;--busy:${(rise / MAX_RISE).toFixed(3)}`} data-nix-perch data-nix-along="0.95" data-nix-phone={i === skyline.length - 1 ? '' : undefined}>
              <ProjectCard project={data} commits={commits} lang={lang} />
            </div>
          ))}
        </div>
        <span class="plank builds-plank"></span>
      </section>

      <section class="notes wrap" aria-labelledby="notes-title">
        <div class="notes-head">
          <h2 id="notes-title" class="display">{t.notes}<span class="period">.</span></h2>
          <a class="text-link" href={localize('/blog/', lang)}>{t.all} <span aria-hidden="true">→</span></a>
        </div>
        <span class="plank" data-nix-perch data-nix-along="0.97" data-nix-phone></span>
        <div class="hung">
          {recentPosts.map((post, i) => (
            <a class="sheet" style={`--drop:${hanging[i % hanging.length]}px`} href={post.href} lang={post.lang}>
              <span class="sheet-meta">
                <time datetime={post.data.pubDate.toISOString()}>{dateLabel.format(post.data.pubDate)}</time>
                {ko && post.lang === 'en' && <span class="sheet-lang" lang="ko">{t.english}</span>}
              </span>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </a>
          ))}
        </div>
      </section>
      <NixChan perch="[data-nix-perch]" travel />
    </main>
    <Footer />
  </body>
</html>
<style>
  main { position: relative; overflow: clip; }
  section h2 { font-size: clamp(36px, 5vw, 60px); margin: 0; }

  .hero { --word: min(29vw, 335px); isolation: isolate; padding-top: clamp(90px, 9vw, 120px); }
  .word {
    display: flex;
    justify-content: space-between;
    margin: 0;
    padding-inline: 2%;
    font-size: var(--word);
    line-height: 1;
    color: var(--letter);
    text-shadow: .006em .006em 0 var(--letter-side), .012em .012em 0 var(--letter-side), .018em .018em 0 var(--letter-side), .024em .024em 0 var(--letter-side);
  }
  .letter { display: block; transition: transform .18s cubic-bezier(.3, 1.6, .5, 1); }
  .letter:hover { transform: translateY(-2.5%); }
  .dot { color: var(--star); text-shadow: none; }
  .word-break { display: none; }
  .cap-narrow { display: none; }
  .hero-plank { position: relative; z-index: -1; margin-top: calc(var(--word) * -.057); }
  .intro { display: flex; align-items: flex-start; justify-content: space-between; gap: 32px; margin-top: 30px; padding-left: calc(var(--word) * .36); }
  .intro p { margin: 0; max-width: 34em; font-size: clamp(18px, 2vw, 23px); font-weight: 700; line-height: 1.45; }
  .keys { display: flex; flex-wrap: wrap; gap: 12px; flex: none; padding-top: 4px; }

  .space { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: clamp(36px, 7vw, 90px); align-items: center; padding-top: clamp(90px, 11vw, 140px); }
  .space p { margin: 20px 0 22px; max-width: 36em; color: var(--muted); font-size: 18px; font-weight: 600; }

  .builds { position: relative; padding-top: clamp(90px, 11vw, 140px); }
  .builds-head { position: absolute; left: 0; width: 66%; }
  .builds-head p { margin: 8px 0 12px; color: var(--muted); font-weight: 700; }
  .skyline { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: end; gap: 20px; padding-top: 210px; }
  .stand { display: flex; min-height: calc(250px + var(--rise)); }
  .stand :global(.project-card) { flex: 1; border-radius: 16px 16px 0 0; box-shadow: none; }
  .stand :global(.project-card:hover) { transform: none; box-shadow: none; }
  .stand:hover { transform: translateY(-5px); }
  .stand { transition: transform .15s; }
  .stand :global(.card-top) { justify-content: flex-start; flex-wrap: wrap; gap: 6px 14px; padding-right: calc(var(--nix-w) * .6); }

  /* The heading already keeps Nixchan's headroom above the plank, so the section needs little of its own. */
  .notes { padding-top: clamp(40px, 5vw, 70px); padding-bottom: 150px; }
  .notes-head { display: flex; align-items: end; justify-content: space-between; gap: 20px; min-height: var(--nix-above); padding-bottom: 14px; padding-right: calc(var(--nix-w) + 50px); }
  .hung { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: start; gap: 20px; }
  .sheet {
    position: relative;
    display: block;
    margin-top: var(--drop);
    padding: 22px;
    background: var(--surface);
    border-radius: 6px;
    box-shadow: 0 16px 24px -14px var(--shadow);
    transform-origin: 50% calc(var(--drop) * -1);
  }
  .sheet::before, .sheet::after { content: ''; position: absolute; bottom: 100%; width: 2px; height: var(--drop); background: var(--string); }
  .sheet::before { left: 16%; }
  .sheet::after { right: 16%; }
  .sheet:hover { animation: sheet-swing 1s ease-in-out; }
  .sheet-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; color: var(--accent); font-size: 13px; font-weight: 800; }
  .sheet-lang { font-size: 11px; background: var(--accent-soft); border-radius: 999px; padding: 1px 8px; }
  .sheet:lang(ko), .intro:lang(ko), .space:lang(ko) { word-break: keep-all; overflow-wrap: break-word; }
  .sheet h3 { margin: 6px 0 8px; font-size: 21px; font-weight: 900; line-height: 1.25; }
  .sheet p { margin: 0; color: var(--muted); font-size: 15px; line-height: 1.5; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 4; line-clamp: 4; overflow: hidden; }
  @keyframes sheet-swing {
    0%, 100% { transform: rotate(0); }
    25% { transform: rotate(1.3deg); }
    60% { transform: rotate(-.9deg); }
    85% { transform: rotate(.35deg); }
  }

  /* Phones get their own composition: the wordmark stacks so it can stay huge. */
  @media (max-width: 850px) {
    .hero { --word: min(43vw, 270px); padding-top: 34px; }
    .word { flex-wrap: wrap; justify-content: flex-end; padding-inline: 0; }
    .word-break { display: block; flex-basis: 100%; height: 0; }
    .letter:nth-of-type(n + 4), .dot { margin-top: -.16em; }
    .hero-plank { height: 12px; }
    .intro { flex-direction: column; gap: 20px; margin-top: 24px; padding-left: 0; }
    .intro p { font-size: 20px; }
    .keys { width: 100%; }
    .keys .button { flex: 1 1 0; justify-content: center; white-space: nowrap; padding-inline: 12px; }

    .space { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 18px 22px; align-items: start; padding-top: 76px; }
    .space-text { display: contents; }
    .space h2 { grid-column: 1 / -1; grid-row: 1; }
    .space p { grid-column: 1; grid-row: 2; margin: 0; font-size: 16.5px; }
    .space .art { grid-column: 2; grid-row: 2 / span 2; margin-top: 8px; }
    .space .text-link { grid-column: 1; grid-row: 3; justify-self: start; }

    .builds { padding-top: 84px; }
    .builds-head { position: static; width: auto; padding-right: calc(var(--nix-w) + 6px); }
    .builds-head p { font-size: 15px; line-height: 1.35; }
    .cap-wide { display: none; }
    .cap-narrow { display: inline; }
    .builds-plank { display: none; }
    /* Busiest first, and longer rather than taller, so the steps survive one column. */
    .skyline { display: flex; flex-direction: column-reverse; gap: 16px; padding-top: 12px; }
    .stand { min-height: 0; width: calc(74% + var(--busy) * 26%); }
    .stand:hover { transform: none; }
    .stand :global(.project-card) { border-radius: 16px; box-shadow: 0 6px 0 var(--edge); padding: 22px; }
    .stand :global(.project-card:hover) { box-shadow: 0 6px 0 var(--edge); }
    .stand :global(.card-top) { padding-right: calc(var(--nix-w) * .95); }

    .notes { padding-top: 76px; padding-bottom: 90px; }
    .notes-head { flex-direction: column; align-items: start; justify-content: end; padding-right: calc(var(--nix-w) + 10px); }
    .hung { grid-template-columns: 1fr; gap: 0; }
    .sheet { --drop: 26px !important; transform-origin: 50% -26px; }
    .sheet:nth-child(odd) { margin-right: 9%; }
    .sheet:nth-child(even) { margin-left: 9%; }
  }
  @media (prefers-reduced-motion: reduce) { .sheet:hover { animation: none; } .letter:hover, .stand:hover { transform: none; } }
</style>

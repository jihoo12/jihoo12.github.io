---
import { Image } from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { comicSlug, publishedComics } from '../../lib/comics';
import headerArt from '../../assets/nixchan/nixchan-whiteboard-01.png';
import emptyArt from '../../assets/nixchan/nixchan-sleepy-desk-01.png';

const comics = await publishedComics();
const dateLabel = new Intl.DateTimeFormat('en-US', { dateStyle: 'medium' });
---
<!doctype html>
<html lang="en">
  <head><BaseHead title="Comics — Jihoo" description="Little comics about code, curiosity, and everyday life." /></head>
  <body>
    <Header />
    <main class="wrap comics-main">
      <div class="page-head">
        <div>
          <span class="eyebrow">PANELS & DOODLES</span>
          <h1>Comics<span class="period">.</span></h1>
          <p class="comics-subtitle">Little stories about code, bugs, and everyday life, a few panels at a time.</p>
        </div>
        <div class="art"><Image src={headerArt} alt="Nixchan sketching on a whiteboard" width={600} loading="eager" /></div>
      </div>
      {comics.length > 0 ? (
        <div class="strips">
          {comics.map((comic, i) => (
            <a class="strip" href={`/comics/${comicSlug(comic.id)}/`}>
              <Image class="strip-art" src={comic.data.cover ?? comic.data.pages[0].src} alt="" width={560} height={700} fit="cover" position="top" loading={i < 3 ? 'eager' : 'lazy'} />
              <div class="strip-body" lang={comic.data.lang}>
                <span class="strip-meta">
                  {comic.data.draft && <span class="strip-draft">Draft</span>}
                  <span class="strip-no">#{comics.length - i}</span>
                  <time datetime={comic.data.pubDate.toISOString()}>{dateLabel.format(comic.data.pubDate)}</time>
                  <span class="strip-count">· {comic.data.pages.length} {comic.data.pages.length === 1 ? 'page' : 'pages'}</span>
                </span>
                <h2>{comic.data.title}</h2>
                <p>{comic.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="comics-empty">
          <Image src={emptyArt} alt="Nixchan dozing at her desk" width={320} />
          <h2>The first comic is still on the drawing board.</h2>
          <p>Check back soon!</p>
          <a class="text-link" href="/blog/">Read the journal meanwhile →</a>
        </div>
      )}
    </main>
    <Footer />
  </body>
</html>
<style>
  .comics-main { min-height: 72vh; padding-top: 80px; padding-bottom: 130px; }
  .page-head { display: grid; grid-template-columns: 1fr 300px; gap: 60px; align-items: center; }
  .comics-main h1 { font-size: clamp(48px, 6vw, 70px); line-height: 1.15; margin: 25px 0 16px; }
  .comics-subtitle { margin: 0; color: var(--muted); font-size: 17px; font-weight: 600; line-height: 1.7; }

  /* Each comic is pinned up by its cover, tall like a page torn out of a sketchbook. */
  .strips { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 48px 30px; margin-top: 84px; }
  .strip {
    position: relative; display: flex; flex-direction: column; gap: 14px;
    padding: 12px 12px 20px; background: var(--surface); border-radius: 5px;
    box-shadow: 0 18px 30px -14px var(--shadow);
    transform: rotate(var(--tilt, 0deg));
    transition: transform .22s cubic-bezier(.3, 1.5, .5, 1), box-shadow .22s;
  }
  .strip:nth-child(3n + 1) { --tilt: -.9deg; }
  .strip:nth-child(3n + 2) { --tilt: .7deg; }
  .strip:nth-child(3n + 3) { --tilt: -.4deg; }
  /* A pushpin instead of tape, so comics and notes read as different things on the same wall. */
  .strip::before {
    content: ''; position: absolute; z-index: 1; top: -9px; left: 50%; width: 20px; height: 20px; margin-left: -10px;
    border-radius: 50%; background: radial-gradient(circle at 35% 35%, #ffe08a, var(--star) 55%, #b98c22);
    box-shadow: 0 3px 4px var(--shadow);
  }
  .strip:hover, .strip:focus-visible { transform: rotate(0) translateY(-6px); box-shadow: 0 28px 36px -16px var(--shadow); }
  .strip-no { padding: 1px 9px; border-radius: 999px; background: var(--navy); color: var(--surface); font-weight: 900; }
  .strip-art { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: top; border-radius: 2px; }
  .strip-body { display: flex; flex-direction: column; align-items: flex-start; padding: 0 8px; }
  .strip-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; color: var(--accent); font-size: 13px; font-weight: 800; }
  .strip-draft { background: var(--star); color: #1c1a3e; border-radius: 999px; padding: 1px 9px; font-weight: 900; }
  .strip-body:lang(ko) { word-break: keep-all; overflow-wrap: break-word; }
  .strip h2 { margin: 6px 0 8px; font-size: 20px; font-weight: 900; line-height: 1.28; text-wrap: balance; }
  .strip p { margin: 0; color: var(--muted); font-size: 14.5px; line-height: 1.55; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden; }

  .comics-empty { margin-top: 70px; padding: 50px 25px; text-align: center; border: 1px dashed var(--line); border-radius: 16px; background: var(--bg-tint); }
  .comics-empty img { width: 160px; border-radius: 16px; }
  .comics-empty h2 { font-size: 21px; margin: 12px 0; text-wrap: balance; }
  .comics-empty p { font-size: 14px; color: var(--muted); margin-bottom: 25px; }

  @media (max-width: 980px) { .strips { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) {
    .page-head { grid-template-columns: 1fr; gap: 36px; }
    .page-head .art { max-width: 240px; }
  }
  @media (max-width: 600px) {
    .comics-main { padding-top: 56px; padding-bottom: 95px; }
    .strips { gap: 22px 14px; margin-top: 60px; }
    .strip { padding: 8px 8px 14px; gap: 10px; }
    .strip-body { padding: 0 4px; }
    .strip h2 { font-size: 16px; margin: 3px 0 0; }
    .strip p, .strip-count { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .strip { transition: none; }
    .strip:hover, .strip:focus-visible { transform: rotate(var(--tilt, 0deg)); }
  }
</style>

---
import { Image } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & {
  /** Language of this page. */
  lang?: 'en' | 'ko';
  /** URLs of this post in each available language, including this page. */
  versions?: { en: string; ko?: string };
  /** For a translation: the date of the English version it follows. */
  translatedFrom?: Date;
  /** Headings of the rendered post, for the table of contents. */
  headings?: MarkdownHeading[];
  /** Set for a paper draft: `description` is then its abstract. */
  paper?: { authors: string[]; writtenWith?: string; code?: string };
};
const { title, description, pubDate, updatedDate, heroImage, lang = 'en', versions, translatedFrom, headings = [], paper } = Astro.props;
const ko = lang === 'ko';
const t = ko
  ? { back: '← 저널로 돌아가기', all: '← 모든 글', updated: '수정', eyebrow: 'JOURNAL / 한국어 번역', toc: '이 글의 내용' }
  : { back: '← Back to journal', all: '← All notes', updated: 'Updated', eyebrow: 'JOURNAL / NOTES', toc: 'On this page' };
if (paper) Object.assign(t, ko ? { all: '← 모든 논문 초안', eyebrow: '논문 초안' } : { all: '← All paper drafts', eyebrow: 'PAPER DRAFT' });
// Markdown always calls the footnote list "Footnotes"; papers call them references.
const footnoteLabel = paper ? (ko ? '참고문헌' : 'References') : ko ? '각주' : 'Footnotes';
const toc = headings
  .filter((h) => h.depth === 2 || h.depth === 3)
  .map((h) => (h.slug === 'footnote-label' ? { ...h, text: footnoteLabel } : h));
// Paper drafts are English only, so they always go back to the English journal.
const backHref = paper ? '/blog/#papers' : ko ? '/ko/blog/' : '/blog/';
// Where the header's language sign leads: the other version of this post, or else the Korean journal.
const alternate = paper ? '/ko/blog/#papers' : ko ? versions?.en : (versions?.ko ?? '/ko/blog/');
const listAuthors = (names: string[]) => new Intl.ListFormat(ko ? 'ko' : 'en', { type: 'conjunction' }).format(names);
// A contents list only earns its place on posts long enough to get lost in.

const showToc = toc.length >= 3;
const alternates = versions?.ko
  ? [
      { hreflang: 'en', href: versions.en },
      { hreflang: 'ko', href: versions.ko },
      { hreflang: 'x-default', href: versions.en },
    ]
  : [];
const fmtKo = (d: Date) => new Intl.DateTimeFormat('ko-KR', { dateStyle: 'long' }).format(d);
---
<!doctype html>
<html lang={lang}>
  <head><BaseHead title={`${title} — Jihoo`} description={description} locale={ko ? 'ko_KR' : 'en_US'} alternates={alternates} /></head>
  <body>
    <div class="progress" data-progress aria-hidden="true"></div>
    <Header alternate={alternate} />
    <main class="wrap article-page">
      <div class="article-top">
        <a class="back-link" href={backHref}>{t.back}</a>
        {versions?.ko && (
          <nav class="lang-switch" aria-label="Language">
            <a href={versions.en} hreflang="en" lang="en" aria-current={ko ? undefined : 'page'}>English</a>
            <a href={versions.ko} hreflang="ko" lang="ko" aria-current={ko ? 'page' : undefined}>한국어</a>
          </nav>
        )}
      </div>
      <article>
        <header class:list={['article-header', { 'has-art': heroImage }]}>
          <div>
            <span class="eyebrow">{t.eyebrow}</span>
            <h1>{title}</h1>
            {paper ? <p class="authors">{listAuthors(paper.authors)}</p> : <p>{description}</p>}
            {paper?.code && (
              <a class="code-link" href={paper.code} target="_blank" rel="noopener noreferrer">
                {ko ? '코드와 실험' : 'Code & experiments'} <span class="code-host">{paper.code.replace(/^https?:\/\/(www\.)?/, '')}</span> <span aria-hidden="true">↗</span>
              </a>
            )}
            <div class="article-date">
              {ko ? fmtKo(pubDate) : <FormattedDate date={pubDate} />}
              {updatedDate && <> · {t.updated} {ko ? fmtKo(updatedDate) : <FormattedDate date={updatedDate} />}</>}
            </div>
          </div>
          {heroImage && <div class="art"><Image src={heroImage} alt="" width={480} loading="eager" /></div>}
        </header>
        {paper && (
          <div class="paper-front">
            <p class="paper-notice">
              {ko
                ? <><strong>실험적인 초안이에요.</strong> {paper.writtenWith ? `대부분 ${paper.writtenWith}가 썼고, ` : ''}동료 심사를 거치지 않았어요. 주장이나 참고문헌에 틀린 부분이 있을 수 있어요.</>
                : <><strong>An exploratory draft.</strong> {paper.writtenWith ? `Mostly written by ${paper.writtenWith}; it` : 'It'} hasn't been peer reviewed, so claims and references may be wrong.</>}
            </p>
            <section class="abstract" aria-label={ko ? '초록' : 'Abstract'}>
              <h2>{ko ? '초록' : 'Abstract'}</h2>
              <p>{description}</p>
            </section>
          </div>
        )}
        {ko && versions && translatedFrom && (
          <p class="translation-note">
            이 글은 <a href={versions.en} hreflang="en">영어 원문</a>({fmtKo(translatedFrom)} 버전)을 번역한 글이에요. 내용이 다르면 원문이 기준이에요.
          </p>
        )}
        <div class="reading">
          <div class:list={['prose', { ko }]} style={`--footnote-label: "${footnoteLabel}"`} data-article><slot /></div>
          {showToc && (
            <aside class="toc">
              <nav aria-label={t.toc}>
                <span class="toc-title">{t.toc}</span>
                <ol>
                  {toc.map((h) => (
                    <li class:list={{ sub: h.depth === 3 }}><a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a></li>
                  ))}
                </ol>
              </nav>
            </aside>
          )}
        </div>
      </article>
      <a class="back-link bottom" href={backHref}>{t.all}</a>
    </main>
    <Footer />
  </body>
</html>
<script>
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  const article = document.querySelector<HTMLElement>('[data-article]');
  const links = new Map(Array.from(document.querySelectorAll<HTMLElement>('[data-toc]'), (a) => [a.dataset.toc!, a]));
  const headings = article ? Array.from(article.querySelectorAll<HTMLElement>('h2[id], h3[id]')).filter((h) => links.has(h.id)) : [];
  let queued = false;

  function update() {
    queued = false;
    if (!article) return;
    const box = article.getBoundingClientRect();
    const read = Math.min(1, Math.max(0, (innerHeight * 0.5 - box.top) / box.height));
    bar?.style.setProperty('transform', `scaleX(${read.toFixed(4)})`);
    // The section being read is the last heading that has passed the top third of the screen.
    let current: HTMLElement | undefined;
    for (const h of headings) {
      if (h.getBoundingClientRect().top > innerHeight * 0.33) break;
      current = h;
    }
    links.forEach((a, id) => a.classList.toggle('here', id === current?.id));
  }
  function queue() {
    if (queued) return;
    queued = true;
    requestAnimationFrame(update);
  }
  addEventListener('scroll', queue, { passive: true });
  addEventListener('resize', queue);
  update();
</script>
<style>
  .progress { position: fixed; z-index: 20; inset: 0 0 auto; height: 4px; background: var(--star); transform: scaleX(0); transform-origin: 0 50%; }
  .article-page { max-width: 900px; padding-top: 56px; padding-bottom: 110px; }
  .article-page:lang(ko) { word-break: keep-all; overflow-wrap: break-word; }
  .article-top { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
  .back-link { font-size: 15px; color: var(--accent); font-weight: 800; }
  .back-link:hover { text-decoration: underline; text-underline-offset: 4px; }
  .bottom { display: inline-block; margin-top: 70px; }
  .lang-switch { display: flex; gap: 4px; padding: 4px; border-radius: 999px; background: var(--surface); box-shadow: 0 3px 0 var(--edge); }
  .lang-switch a { font-size: 13px; font-weight: 800; padding: 5px 13px; border-radius: 999px; color: var(--muted); }
  .lang-switch a:hover { color: var(--accent); }
  .lang-switch a[aria-current='page'] { background: var(--star); color: #1c1a3e; }

  .article-header { padding: 34px 0 38px; }
  .article-header.has-art { display: grid; grid-template-columns: 1fr 240px; gap: 50px; align-items: center; }
  .article-header h1 { font-size: clamp(36px, 5.2vw, 58px); line-height: 1.18; margin: 14px 0 18px; text-wrap: balance; }
  .article-header p { font-size: 19px; font-weight: 600; color: var(--muted); line-height: 1.6; margin: 0; }
  .article-date { color: var(--faint); font-size: 14px; font-weight: 800; margin-top: 18px; }
  .authors { font-size: 17px !important; color: var(--ink) !important; font-weight: 800 !important; }
  .code-link { display: inline-flex; flex-wrap: wrap; align-items: baseline; gap: 4px 8px; margin-top: 14px; padding: 7px 14px; border-radius: 10px; background: var(--surface); box-shadow: 0 4px 0 var(--edge); font-size: 14px; font-weight: 800; transition: transform .1s, box-shadow .1s; }
  .code-link:hover { transform: translateY(-2px); box-shadow: 0 6px 0 var(--edge); }
  .code-host { color: var(--accent); font-weight: 700; overflow-wrap: anywhere; }
  .paper-front { display: grid; gap: 18px; margin: -10px 0 40px; }
  .paper-notice { margin: 0; font-size: 14px; line-height: 1.7; color: var(--muted); background: color-mix(in srgb, var(--star) 22%, var(--surface)); border-left: 4px solid var(--star); border-radius: 10px; padding: 12px 16px; }
  .paper-notice strong { color: var(--ink); }
  .abstract { padding: 20px 24px; border: 2px dashed var(--line); border-radius: 14px; }
  .abstract h2 { margin: 0 0 8px; color: var(--accent); font-size: 13px; font-weight: 900; letter-spacing: .4px; text-transform: uppercase; }
  .abstract p { margin: 0; font-size: 16px; line-height: 1.75; color: var(--prose); }
  .translation-note { font-size: 14px; line-height: 1.8; color: var(--muted); background: var(--bg-tint); border: 1px solid var(--line); border-radius: 12px; padding: 14px 18px; margin: -16px 0 40px; }
  .translation-note a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }

  .reading { position: relative; }
  .prose { font-size: 17.5px; line-height: 1.8; color: var(--prose); background: var(--surface); padding: clamp(24px, 5vw, 56px); border-radius: 16px; box-shadow: 0 7px 0 var(--edge); }
  .prose.ko { line-height: 1.9; }
  .prose > :global(:first-child) { margin-top: 0; }
  .prose > :global(:last-child) { margin-bottom: 0; }
  .prose :global(h2) { font-size: 29px; line-height: 1.25; margin: 56px 0 16px; font-weight: 900; color: var(--ink); scroll-margin-top: 28px; }
  .prose :global(h3) { font-size: 22px; line-height: 1.3; margin: 36px 0 12px; font-weight: 900; color: var(--ink); scroll-margin-top: 28px; }
  .prose :global(a) { color: var(--accent); text-decoration: underline; text-decoration-color: var(--sky); text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .prose :global(a:hover) { text-decoration-color: var(--star); }
  .prose :global(strong) { color: var(--ink); font-weight: 800; }
  .prose :global(li) { margin: 4px 0; }
  .prose :global(li::marker) { color: var(--accent); font-weight: 800; }
  .prose :global(code) { font-family: ui-monospace, 'SF Mono', 'JetBrains Mono', Menlo, Consolas, monospace; font-size: .86em; background: var(--accent-soft); padding: 2px 6px; border-radius: 5px; }
  /* Code blocks wear the hoodie's navy instead of the highlighter's own grey. */
  .prose :global(pre) { overflow-x: auto; margin: 26px 0; background: var(--code-bg) !important; color: var(--code-ink); padding: 20px 22px; border-radius: 12px; font-size: 14.5px; line-height: 1.65; scrollbar-width: thin; scrollbar-color: #6d6ab8 transparent; }
  .prose :global(pre code) { background: none; padding: 0; font-size: 1em; }
  .prose :global(blockquote) { border-left: 4px solid var(--star); margin: 26px 0; padding: 2px 0 2px 20px; color: var(--muted); }
  .prose :global(img) { max-width: 100%; height: auto; border-radius: 9px; }
  .prose :global(hr) { border: 0; height: 2px; margin: 44px 0; background: var(--line); }
  .prose :global(table) { width: 100%; display: block; overflow-x: auto; border-collapse: collapse; font-size: 15.5px; line-height: 1.5; }
  .prose :global(th) { text-align: left; color: var(--ink); font-weight: 900; border-bottom: 2px solid var(--ink); padding: 8px 14px 8px 0; }
  /* Markdown footnotes double as a paper's references. */
  .prose :global(.footnotes) { margin-top: 56px; padding-top: 22px; border-top: 2px solid var(--line); font-size: 14.5px; line-height: 1.65; }
  .prose :global(.footnotes h2) { margin: 0 0 10px; font-size: 0; }
  .prose :global(.footnotes h2::before) { content: var(--footnote-label); font-size: 13px; color: var(--accent); letter-spacing: .4px; text-transform: uppercase; }
  .prose :global(sup a) { text-decoration: none; font-weight: 800; }
  .prose :global(td) { border-bottom: 1px solid var(--line); padding: 9px 14px 9px 0; vertical-align: top; }

  /* The contents hang on a string beside the page, and a bead marks where you are. */
  .toc { display: none; position: absolute; top: 0; bottom: 0; left: calc(100% + 34px); width: 200px; }
  .toc nav { position: sticky; top: 36px; max-height: calc(100vh - 72px); overflow-y: auto; scrollbar-width: none; padding-left: 6px; }
  .toc-title { display: block; margin: 0 0 12px 18px; color: var(--accent); font-size: 12.5px; font-weight: 900; letter-spacing: .4px; text-transform: uppercase; }
  .toc ol { list-style: none; margin: 0; padding: 0; border-left: 2px solid var(--string); }
  .toc a { position: relative; display: block; padding: 5px 0 5px 18px; color: var(--faint); font-size: 13.5px; font-weight: 700; line-height: 1.35; transition: color .15s; }
  .toc .sub a { padding-left: 30px; font-size: 13px; font-weight: 600; }
  .toc a:hover { color: var(--ink); }
  .toc a::before { content: ''; position: absolute; left: -7px; top: .62em; width: 12px; height: 12px; border-radius: 50%; background: var(--star); transform: scale(0); transition: transform .2s cubic-bezier(.3, 1.6, .5, 1); }
  .toc a.here { color: var(--ink); }
  .toc a.here::before { transform: scale(1); }
  @media (min-width: 1420px) { .toc { display: block; } }

  @media (max-width: 700px) {
    .article-header.has-art { grid-template-columns: 1fr; gap: 30px; }
    .article-header .art { max-width: 200px; order: -1; }
  }
  @media (max-width: 600px) {
    .article-page { padding-top: 50px; padding-bottom: 85px; }
    .article-header { padding-top: 36px; }
    .article-header h1 { font-size: 34px; }
    .article-header p { font-size: 17px; }
    .prose { font-size: 16.5px; }
    .prose :global(pre) { margin-inline: -8px; padding: 16px; font-size: 13.5px; }
  }
  @media (prefers-reduced-motion: reduce) { .toc a::before { transition: none; } }
</style>
